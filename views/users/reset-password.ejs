<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <title>Reset Password | SOLESYNTAX</title>
    <link rel="icon" type="image/png" href="/images/Logo.png">
</head>

<body>

    <div class="page">
        <div class="bg-circle bg-circle-1"></div>
        <div class="bg-circle bg-circle-2"></div>

        <div class="card">
            <!-- Brand -->
            <div class="card-brand">
                <span class="brand-name">
                    <span class="brand-accent"><a href="/">SOLESYNTAX</a></span>
                </span>
            </div>

            <!-- Header -->
            <div class="card-header">
                <h1>Reset password</h1>
                <p>Choose a new password for your account</p>
            </div>

            <!-- Global error / success alerts -->
            <div id="globalError" class="error-alert" style="display:none;"></div>

            <!-- Form -->
            <form class="form" id="resetForm" novalidate>
                <!-- Hidden token from URL -->
                <input type="hidden" id="token" value="<%= token %>" />

                <!-- New password -->
                <div class="field">
                    <div class="input-wrapper">
                        <input type="password" id="password" placeholder=" " required minlength="8" />
                        <label for="password">New Password</label>
                        <button type="button" class="toggle-password" aria-label="Toggle password visibility" data-target="password">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                    <div class="password-hint">Must be at least 8 characters</div>
                    <div class="error-message" id="passwordError"></div>
                </div>

                <!-- Confirm password -->
                <div class="field">
                    <div class="input-wrapper">
                        <input type="password" id="confirmPassword" placeholder=" " required minlength="8" />
                        <label for="confirmPassword">Confirm New Password</label>
                        <button type="button" class="toggle-password" aria-label="Toggle password visibility" data-target="confirmPassword">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                    <div class="error-message" id="confirmError"></div>
                </div>

                <!-- Password strength indicator -->
                <div class="strength-meter" id="strengthMeter">
                    <div class="strength-bar"><div class="strength-fill" id="strengthFill"></div></div>
                    <span class="strength-label" id="strengthLabel"></span>
                </div>

                <!-- Submit -->
                <button type="submit" class="btn-primary" id="submitBtn">Reset Password</button>
            </form>

            <!-- Footer -->
            <div class="card-footer">
                Remember your password? <a href="/users/login">Log in</a>
            </div>
        </div>
    </div>

    <style>
        /* ============================================================
           DESIGN SYSTEM
           ============================================================ */
        :root {
            --primary: #88c8bc;
            --primary-dark: #66a59b;
            --primary-light: #f0f9f7;
            --success: #28a745;
            --danger: #dc3545;
            --warning: #f5a623;

            --white: #ffffff;
            --off-white: #f8fafc;
            --gray-50: #f9fafb;
            --gray-100: #f1f3f5;
            --gray-200: #e9ecef;
            --gray-300: #dee2e6;
            --gray-400: #ced4da;
            --gray-500: #adb5bd;
            --gray-600: #6c757d;
            --gray-700: #495057;
            --gray-800: #343a40;
            --gray-900: #1a1a2e;

            --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.04);
            --shadow-md: 0 8px 40px rgba(0, 0, 0, 0.07);
            --shadow-lg: 0 16px 60px rgba(0, 0, 0, 0.10);

            --radius-sm: 8px;
            --radius: 14px;
            --radius-lg: 24px;

            --font: 'Poppins', system-ui, -apple-system, sans-serif;
            --font-weight-normal: 400;
            --font-weight-medium: 500;
            --font-weight-semibold: 600;
            --font-weight-bold: 700;

            --duration: 0.30s;
        }

        /* ============================================================
           RESET & BASE
           ============================================================ */
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            font-size: 62.5%;
        }

        body {
            font-family: var(--font);
            font-size: 1.6rem;
            font-weight: var(--font-weight-normal);
            line-height: 1.6;
            color: var(--gray-800);
            background: var(--off-white);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            -webkit-font-smoothing: antialiased;
        }

        a {
            color: var(--primary-dark);
            text-decoration: none;
            font-weight: var(--font-weight-medium);
            transition: color var(--duration) ease;
        }
        a:hover {
            color: var(--primary);
            text-decoration: underline;
        }

        /* ============================================================
           BACKGROUND CIRCLES
           ============================================================ */
        .page {
            position: relative;
            width: 100%;
            max-width: 440px;
            margin: 0 auto;
        }

        .bg-circle {
            position: fixed;
            border-radius: 50%;
            pointer-events: none;
            z-index: 0;
            opacity: 0.30;
        }
        .bg-circle-1 {
            width: 380px;
            height: 380px;
            top: -120px;
            right: -120px;
            background: radial-gradient(circle, var(--primary-light) 0%, transparent 70%);
        }
        .bg-circle-2 {
            width: 300px;
            height: 300px;
            bottom: -100px;
            left: -100px;
            background: radial-gradient(circle, rgba(136, 200, 188, 0.15) 0%, transparent 70%);
        }

        /* ============================================================
           CARD
           ============================================================ */
        .card {
            position: relative;
            z-index: 1;
            background: var(--white);
            padding: 4rem 3.2rem 3.6rem;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            transition: box-shadow var(--duration) ease;
        }
        .card:hover {
            box-shadow: var(--shadow-lg);
        }

        .card-brand {
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Rokkitt', Georgia, serif;
            font-size: 34px;
            font-weight: 700;
            color: var(--primary);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 2.4rem;
        }
        .brand-accent a {
            font-weight: var(--font-weight-bold) !important;
            color: var(--primary-dark);
            text-decoration: none;
        }

        .card-header {
            text-align: center;
            margin-bottom: 3.2rem;
        }
        .card-header h1 {
            font-size: 2.8rem;
            font-weight: var(--font-weight-semibold);
            letter-spacing: -0.5px;
            color: var(--gray-900);
            line-height: 1.2;
        }
        .card-header p {
            margin-top: 0.4rem;
            font-size: 1.5rem;
            color: var(--gray-600);
        }

        /* ============================================================
           FORM
           ============================================================ */
        .form {
            display: flex;
            flex-direction: column;
            gap: 1.8rem;
        }

        .field {
            position: relative;
            display: flex;
            flex-direction: column;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-wrapper input {
            width: 100%;
            height: 52px;
            padding: 0 4.4rem 0 1.6rem;
            font-size: 1.5rem;
            font-family: var(--font);
            color: var(--gray-900);
            background: var(--white);
            border: 1.5px solid var(--gray-300);
            border-radius: var(--radius-sm);
            outline: none;
            transition: border-color var(--duration) ease, box-shadow var(--duration) ease;
            -webkit-appearance: none;
        }
        .input-wrapper input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(136, 200, 188, 0.18);
        }
        .input-wrapper input:not(:placeholder-shown) {
            border-color: var(--gray-400);
        }

        .input-wrapper label {
            position: absolute;
            top: 50%;
            left: 1.6rem;
            transform: translateY(-50%);
            font-size: 1.4rem;
            font-weight: var(--font-weight-normal);
            color: var(--gray-500);
            pointer-events: none;
            transition: all var(--duration) ease;
            background: var(--white);
            padding: 0 4px;
            line-height: 1;
        }
        .input-wrapper input:focus + label,
        .input-wrapper input:not(:placeholder-shown) + label {
            top: 0;
            left: 1.2rem;
            transform: translateY(-50%);
            font-size: 1.1rem;
            font-weight: var(--font-weight-medium);
            color: var(--primary-dark);
            background: var(--white);
        }
        .input-wrapper input:not(:focus):not(:placeholder-shown) + label {
            color: var(--gray-600);
        }

        /* Toggle password button */
        .toggle-password {
            position: absolute;
            right: 1.2rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--gray-500);
            cursor: pointer;
            padding: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: color var(--duration) ease, background var(--duration) ease;
        }
        .toggle-password:hover {
            color: var(--gray-700);
            background: var(--gray-100);
        }
        .toggle-password:focus {
            outline: none;
            box-shadow: none;
        }
        .toggle-password svg {
            display: block;
        }

        /* Password hint */
        .password-hint {
            font-size: 1.2rem;
            color: var(--gray-600);
            margin-top: 4px;
        }

        /* Error messages */
        .error-message {
            font-size: 1.2rem;
            color: var(--danger);
            margin-top: 4px;
            min-height: 1.8rem;
            transition: all 0.2s ease;
        }
        .field.error .input-wrapper input {
            border-color: var(--danger);
            box-shadow: 0 0 0 4px rgba(220, 53, 69, 0.15);
        }
        .field.error .input-wrapper label {
            color: var(--danger);
        }

        /* Alerts */
        .error-alert,
        .success-alert {
            padding: 10px 14px;
            border-radius: 6px;
            font-size: 1.4rem;
            margin-bottom: 1.6rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .error-alert {
            background: #f8d7da;
            border: 1px solid #f5c6cb;
            color: #721c24;
        }
        .success-alert {
            background: #d4edda;
            border: 1px solid #c3e6cb;
            color: #155724;
        }

        /* Password strength meter */
        .strength-meter {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-top: -0.6rem;
        }
        .strength-bar {
            flex: 1;
            height: 4px;
            background: var(--gray-200);
            border-radius: 2px;
            overflow: hidden;
        }
        .strength-fill {
            height: 100%;
            width: 0%;
            background: var(--danger);
            border-radius: 2px;
            transition: all 0.3s ease;
        }
        .strength-fill.weak   { width: 33%; background: var(--danger); }
        .strength-fill.medium { width: 66%; background: var(--warning); }
        .strength-fill.strong { width: 100%; background: var(--success); }

        .strength-label {
            font-size: 1.2rem;
            font-weight: var(--font-weight-medium);
            color: var(--gray-600);
            min-width: 6rem;
            text-align: right;
        }
        .strength-label.weak   { color: var(--danger); }
        .strength-label.medium { color: var(--warning); }
        .strength-label.strong { color: var(--success); }

        /* Primary button */
        .btn-primary {
            width: 100%;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            font-weight: var(--font-weight-semibold);
            font-family: var(--font);
            color: var(--white);
            background: var(--primary);
            border: none;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all var(--duration) ease;
            margin-top: 0.4rem;
            letter-spacing: 0.2px;
        }
        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(136, 200, 188, 0.30);
        }
        .btn-primary:active {
            transform: translateY(0);
            box-shadow: none;
        }
        .btn-primary:focus-visible {
            outline: 2px solid var(--primary-dark);
            outline-offset: 3px;
        }
        .btn-primary:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        /* Footer */
        .card-footer {
            margin-top: 2.8rem;
            text-align: center;
            font-size: 1.4rem;
            color: var(--gray-600);
        }
        .card-footer a {
            font-weight: var(--font-weight-medium);
        }

        /* ============================================================
           RESPONSIVE
           ============================================================ */
        @media (max-width: 500px) {
            .card {
                padding: 3.2rem 2rem 2.8rem;
            }
            .card-header h1 {
                font-size: 2.4rem;
            }
            .input-wrapper input {
                height: 46px;
                font-size: 1.4rem;
            }
            .btn-primary {
                height: 44px;
                font-size: 1.4rem;
            }
            .bg-circle-1 {
                width: 240px;
                height: 240px;
                top: -80px;
                right: -80px;
            }
            .bg-circle-2 {
                width: 200px;
                height: 200px;
                bottom: -60px;
                left: -60px;
            }
        }

        @media (max-width: 380px) {
            .card {
                padding: 2.4rem 1.6rem 2.4rem;
            }
            .card-brand {
                font-size: 2.4rem;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('resetForm');
            const passwordInput = document.getElementById('password');
            const confirmInput = document.getElementById('confirmPassword');
            const tokenInput = document.getElementById('token');
            const globalError = document.getElementById('globalError');
            const submitBtn = document.getElementById('submitBtn');

            const strengthFill = document.getElementById('strengthFill');
            const strengthLabel = document.getElementById('strengthLabel');

            // ---- Helper: show field error ----
            function setFieldError(fieldId, message) {
                const field = document.getElementById(fieldId);
                const errorEl = document.getElementById(fieldId + 'Error');
                if (errorEl) errorEl.textContent = message;
                if (field) field.closest('.field').classList.toggle('error', !!message);
            }

            // ---- Clear all errors ----
            function clearErrors() {
                setFieldError('password', '');
                setFieldError('confirmPassword', '');
                globalError.style.display = 'none';
                globalError.textContent = '';
            }

            // ---- Password strength ----
            function getStrength(pwd) {
                let score = 0;
                if (pwd.length >= 8) score++;
                if (/[A-Z]/.test(pwd)) score++;
                if (/[0-9]/.test(pwd)) score++;
                if (/[^A-Za-z0-9]/.test(pwd)) score++;
                return score; // 0-4
            }

            function updateStrength() {
                const pwd = passwordInput.value;
                const score = getStrength(pwd);

                strengthFill.className = 'strength-fill';
                strengthLabel.className = 'strength-label';

                if (!pwd) {
                    strengthLabel.textContent = '';
                    return;
                }

                if (score <= 1) {
                    strengthFill.classList.add('weak');
                    strengthLabel.classList.add('weak');
                    strengthLabel.textContent = 'Weak';
                } else if (score <= 3) {
                    strengthFill.classList.add('medium');
                    strengthLabel.classList.add('medium');
                    strengthLabel.textContent = 'Medium';
                } else {
                    strengthFill.classList.add('strong');
                    strengthLabel.classList.add('strong');
                    strengthLabel.textContent = 'Strong';
                }
            }

            passwordInput.addEventListener('input', function () {
                setFieldError('password', '');
                updateStrength();
            });

            confirmInput.addEventListener('input', function () {
                setFieldError('confirmPassword', '');
            });

            // ---- Toggle password visibility ----
            document.querySelectorAll('.toggle-password').forEach(btn => {
                btn.addEventListener('click', function () {
                    const targetId = this.dataset.target;
                    const input = document.getElementById(targetId);
                    if (!input) return;
                    const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
                    input.setAttribute('type', type);
                });
            });

            // ---- Validation ----
            function validate() {
                let isValid = true;
                clearErrors();

                const pwd = passwordInput.value;
                const confirm = confirmInput.value;

                if (!pwd) {
                    setFieldError('password', 'Password is required');
                    isValid = false;
                } else if (pwd.length < 8) {
                    setFieldError('password', 'Password must be at least 8 characters');
                    isValid = false;
                }

                if (!confirm) {
                    setFieldError('confirmPassword', 'Please confirm your password');
                    isValid = false;
                } else if (pwd !== confirm) {
                    setFieldError('confirmPassword', 'Passwords do not match');
                    isValid = false;
                }

                return isValid;
            }

            // ---- Submit ----
            form.addEventListener('submit', async function (e) {
                e.preventDefault();

                if (!validate()) return;

                const password = passwordInput.value;
                const token = tokenInput.value;

                const originalText = submitBtn.textContent;
                submitBtn.textContent = 'Resetting...';
                submitBtn.disabled = true;

                try {
                    const response = await fetch('/users/reset-password', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                          token,
                          newPassword: password
                      })
                    });

                    const data = await response.json();

                    if (!response.ok) {
                        throw new Error(data.error || data.message || 'Unable to reset password.');
                    }

                    // Success
                    submitBtn.textContent = '✓ Password reset!';
                    submitBtn.style.backgroundColor = 'var(--success)';

                    setTimeout(() => {
                        window.location.href = '/users/login';
                    }, 1600);

                } catch (err) {
                    globalError.textContent = err.message || 'Something went wrong. Please try again.';
                    globalError.style.display = 'flex';
                    submitBtn.textContent = originalText;
                    submitBtn.disabled = false;
                }
            });
        });
    </script>

</body>

</html>