<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <title>Forgot Password</title>
</head>

<body>

    <div class="page">
        <!-- background circles -->
        <div class="bg-circle bg-circle-1"></div>
        <div class="bg-circle bg-circle-2"></div>

        <div class="card">
            <!-- brand -->
            <div class="card-brand">
                <span class="brand-name"><span class="brand-accent">SOLESYNTAX</span></span>
            </div>

            <!-- header -->
            <div class="card-header">
                <h1>Reset password</h1>
                <p>Enter your email and we'll send you a link to reset your password.</p>
            </div>

            <!-- form -->
            <form class="form" id="resetForm" novalidate>
                <!-- email -->
                <div class="field">
                    <input type="email" id="email" placeholder=" " required />
                    <label for="email">Email address</label>
                </div>

                <!-- submit -->
                <button type="submit" class="btn-primary">Send reset link</button>
            </form>

            <!-- back to login -->
            <div class="back-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                <a href="/users/login">Back to log in</a>
            </div>

            <!-- divider (kept for visual consistency, but no social buttons) -->
            <div class="divider">
                <span>secure &bull; private</span>
            </div>

            <!-- footer hint -->
            <div class="card-footer">
                Remember your password? <a href="/users/login">Log in</a>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('resetForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const btn = e.target.querySelector('.btn-primary');
            const email = document.getElementById('email').value.trim();
            const orig = btn.textContent;

            // ---- Validate email ----
            if (!email) {
                btn.textContent = 'Please enter your email';
                btn.style.backgroundColor = 'var(--danger, #dc3545)';
                setTimeout(() => {
                    btn.textContent = orig;
                    btn.style.backgroundColor = '';
                }, 2000);
                return;
            }

            // ---- Loading state ----
            btn.textContent = 'Sending...';
            btn.style.backgroundColor = '';
            btn.disabled = true;

            try {
                const response = await fetch('/users/forgot-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email })
                });

                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.error || data.message || 'Something went wrong');
                }

                // ---- Success state ----
                btn.textContent = '✓ Sent!';
                btn.style.backgroundColor = 'var(--success, #28a745)';
                btn.disabled = true;

                // Show success message inline (replace with your preferred element if you have one)
                setTimeout(() => {
                    btn.textContent = 'Check your inbox';
                    btn.style.backgroundColor = 'var(--primary-dark, #66a59b)';
                    btn.disabled = false;

                    // Reset button back to original after a moment
                    setTimeout(() => {
                        btn.textContent = orig;
                        btn.style.backgroundColor = '';
                        btn.disabled = false;
                    }, 3000);
                }, 1500);

            } catch (error) {
                // ---- Error state ----
                btn.textContent = error.message || 'Something went wrong';
                btn.style.backgroundColor = 'var(--danger, #dc3545)';
                btn.disabled = true;

                setTimeout(() => {
                    btn.textContent = orig;
                    btn.style.backgroundColor = '';
                    btn.disabled = false;
                }, 2500);
            }
        });
    </script>

    <style>
        /* ============================================================
               DESIGN SYSTEM — same as sign-up & login
               ============================================================ */
        :root {
            --primary: #88c8bc;
            --primary-dark: #66a59b;
            --primary-light: #f0f9f7;
            --success: #28a745;
            --danger: #dc3545;
            --white: #ffffff;
            --off-white: #f8fafc;
            --gray-100: #f1f3f5;
            --gray-200: #e9ecef;
            --gray-300: #dee2e6;
            --gray-400: #ced4da;
            --gray-500: #adb5bd;
            --gray-600: #6c757d;
            --gray-700: #495057;
            --gray-800: #343a40;
            --gray-900: #1a1a2e;
            --shadow-md: 0 8px 40px rgba(0, 0, 0, 0.07);
            --shadow-lg: 0 16px 60px rgba(0, 0, 0, 0.10);
            --radius-sm: 8px;
            --radius-lg: 24px;
            --font: 'Poppins', system-ui, -apple-system, sans-serif;
            --font-weight-normal: 400;
            --font-weight-medium: 500;
            --font-weight-semibold: 600;
            --font-weight-bold: 700;
            --ease: cubic-bezier(0.25, 0.46, 0.45, 0.94);
            --duration: 0.30s;
        }

        /* ============================================================
               RESET & BASE
               ============================================================ */
        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            font-size: 62.5%;
        }

        body {
            font-family: var(--font);
            font-size: 1.6rem;
            font-weight: var(--font-weight-normal);
            line-height: 1.6;
            color: var(--gray-800);
            background: var(--off-white);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            -webkit-font-smoothing: antialiased;
        }

        a {
            color: var(--primary-dark);
            text-decoration: none;
            font-weight: var(--font-weight-medium);
            transition: color var(--duration) ease;
        }
        a:hover {
            color: var(--primary);
            text-decoration: underline;
        }

        /* ============================================================
               BACKGROUND CIRCLES
               ============================================================ */
        .page {
            position: relative;
            width: 100%;
            max-width: 440px;
            margin: 0 auto;
        }

        .bg-circle {
            position: fixed;
            border-radius: 50%;
            pointer-events: none;
            z-index: 0;
            opacity: 0.30;
        }
        .bg-circle-1 {
            width: 380px;
            height: 380px;
            top: -120px;
            right: -120px;
            background: radial-gradient(circle, var(--primary-light) 0%, transparent 70%);
        }
        .bg-circle-2 {
            width: 300px;
            height: 300px;
            bottom: -100px;
            left: -100px;
            background: radial-gradient(circle, rgba(136, 200, 188, 0.15) 0%, transparent 70%);
        }

        /* ============================================================
               CARD
               ============================================================ */
        .card {
            position: relative;
            z-index: 1;
            background: var(--white);
            padding: 4rem 3.2rem 3.6rem;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            transition: box-shadow var(--duration) ease;
            backdrop-filter: blur(2px);
        }
        .card:hover {
            box-shadow: var(--shadow-lg);
        }

        .card-brand {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.6rem;
            margin-bottom: 2.4rem;
            font-size: 2.8rem;
            font-weight: var(--font-weight-semibold);
            letter-spacing: -0.3px;
            color: var(--gray-900);
        }
        .brand-icon {
            font-size: 2.2rem;
            color: var(--primary);
        }
        .brand-name {
            font-weight: var(--font-weight-medium);
        }
        .brand-accent {
            font-weight: var(--font-weight-bold);
            color: var(--primary-dark);
        }

        .card-header {
            text-align: center;
            margin-bottom: 3.2rem;
        }
        .card-header h1 {
            font-size: 2.8rem;
            font-weight: var(--font-weight-semibold);
            letter-spacing: -0.5px;
            color: var(--gray-900);
            line-height: 1.2;
        }
        .card-header p {
            margin-top: 0.6rem;
            font-size: 1.5rem;
            color: var(--gray-600);
            max-width: 90%;
            margin-left: auto;
            margin-right: auto;
        }

        /* ============================================================
               FORM
               ============================================================ */
        .form {
            display: flex;
            flex-direction: column;
            gap: 2.2rem;
        }

        .field {
            position: relative;
            display: flex;
            flex-direction: column;
        }
        .field input {
            width: 100%;
            height: 52px;
            padding: 0 1.6rem;
            font-size: 1.5rem;
            font-family: var(--font);
            color: var(--gray-900);
            background: var(--white);
            border: 1.5px solid var(--gray-300);
            border-radius: var(--radius-sm);
            outline: none;
            transition: border-color var(--duration) ease, box-shadow var(--duration) ease;
            -webkit-appearance: none;
        }
        .field input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(136, 200, 188, 0.18);
        }
        .field input:not(:placeholder-shown) {
            border-color: var(--gray-400);
        }

        .field label {
            position: absolute;
            top: 50%;
            left: 1.6rem;
            transform: translateY(-50%);
            font-size: 1.4rem;
            font-weight: var(--font-weight-normal);
            color: var(--gray-500);
            pointer-events: none;
            transition: all var(--duration) ease;
            background: var(--white);
            padding: 0 4px;
            line-height: 1;
        }
        .field input:focus+label,
        .field input:not(:placeholder-shown)+label {
            top: 0;
            left: 1.2rem;
            transform: translateY(-50%);
            font-size: 1.1rem;
            font-weight: var(--font-weight-medium);
            color: var(--primary-dark);
            background: var(--white);
        }
        .field input:not(:focus):not(:placeholder-shown)+label {
            color: var(--gray-600);
        }

        .btn-primary {
            width: 100%;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            font-weight: var(--font-weight-semibold);
            font-family: var(--font);
            color: var(--white);
            background: var(--primary);
            border: none;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all var(--duration) ease;
            letter-spacing: 0.2px;
        }
        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(136, 200, 188, 0.30);
        }
        .btn-primary:active {
            transform: translateY(0);
            box-shadow: none;
        }
        .btn-primary:focus-visible {
            outline: 2px solid var(--primary-dark);
            outline-offset: 3px;
        }
        .btn-primary:disabled {
            opacity: 0.7;
            cursor: default;
            transform: none;
            box-shadow: none;
        }

        /* ============================================================
               BACK LINK
               ============================================================ */
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            margin-top: 1.6rem;
            font-size: 1.4rem;
            color: var(--gray-600);
            transition: color var(--duration) ease;
        }
        .back-link:hover {
            color: var(--gray-800);
        }
        .back-link svg {
            flex-shrink: 0;
            transition: transform var(--duration) ease;
        }
        .back-link:hover svg {
            transform: translateX(-3px);
        }
        .back-link a {
            font-weight: var(--font-weight-medium);
        }

        /* ============================================================
               DIVIDER (kept for visual consistency)
               ============================================================ */
        .divider {
            display: flex;
            align-items: center;
            gap: 1.6rem;
            margin: 2.4rem 0 1.2rem;
        }
        .divider::before,
        .divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: var(--gray-200);
        }
        .divider span {
            font-size: 1.2rem;
            font-weight: var(--font-weight-medium);
            color: var(--gray-500);
            text-transform: uppercase;
            letter-spacing: 0.6px;
            white-space: nowrap;
        }

        /* ============================================================
               FOOTER
               ============================================================ */
        .card-footer {
            margin-top: 0.8rem;
            text-align: center;
            font-size: 1.4rem;
            color: var(--gray-600);
        }
        .card-footer a {
            font-weight: var(--font-weight-medium);
        }

        /* ============================================================
               RESPONSIVE
               ============================================================ */
        @media (max-width: 500px) {
            .card {
                padding: 3.2rem 2rem 2.8rem;
            }
            .card-header h1 {
                font-size: 2.4rem;
            }
            .card-header p {
                font-size: 1.4rem;
                max-width: 100%;
            }
            .field input {
                height: 46px;
                font-size: 1.4rem;
            }
            .btn-primary {
                height: 44px;
                font-size: 1.4rem;
            }
            .bg-circle-1 {
                width: 240px;
                height: 240px;
                top: -80px;
                right: -80px;
            }
            .bg-circle-2 {
                width: 200px;
                height: 200px;
                bottom: -60px;
                left: -60px;
            }
        }

        @media (max-width: 380px) {
            .card {
                padding: 2.4rem 1.6rem 2.4rem;
            }
            .card-brand {
                font-size: 1.6rem;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>

</body>

</html>