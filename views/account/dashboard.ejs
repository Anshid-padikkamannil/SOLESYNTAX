<h4 class="mb-3"><i class="fas fa-tachometer-alt" style="color:#88c8bc;"></i> Dashboard</h4>
<p class="text-muted">👋 Hi, <strong><%= user ? user.name : 'Guest' %></strong>! Welcome back.</p>

<div class="row mt-4">
    <div class="col-sm-3 col-6 mb-3">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-shopping-bag"></i></div>
            <div class="stat-number"><%= totalOrders || 0 %></div>
            <div class="stat-label">Total Orders</div>
        </div>
    </div>
    <div class="col-sm-3 col-6 mb-3">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-clock"></i></div>
            <div class="stat-number"><%= pendingOrders || 0 %></div>
            <div class="stat-label">Pending Orders</div>
        </div>
    </div>
    <div class="col-sm-3 col-6 mb-3">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-map-pin"></i></div>
            <div class="stat-number"><%= savedAddresses || 0 %></div>
            <div class="stat-label">Saved Addresses</div>
        </div>
    </div>
    <div class="col-sm-3 col-6 mb-3">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-heart"></i></div>
            <div class="stat-number"><%= wishlistItems || 0 %></div>
            <div class="stat-label">Wishlist Items</div>
        </div>
    </div>
</div>

<div class="mt-4">
    <h5>Recent Order</h5>
    <% if (recentOrder) { %>
        <div class="order-item">
            <div class="order-info">
                <strong><%= recentOrder.id %></strong> <span class="text-muted">· <%= recentOrder.date %></span>
                <span class="order-status <%= recentOrder.statusClass %> ml-2"><%= recentOrder.status %></span>
                <div class="text-muted small">Total: ₹<%= recentOrder.total %></div>
            </div>
            <a href="/account/order-details/<%= recentOrder.id %>" class="btn btn-sm btn-outline-primary">View Details</a>
        </div>
    <% } else { %>
        <p class="text-muted">No recent orders.</p>
    <% } %>
    <a href="/account/orders" class="btn btn-primary btn-sm mt-2"><i class="fas fa-list"></i> View All Orders</a>
</div>