<style>
    .password-card {
        max-width: 520px;
        margin: 0 auto;
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        background: #fff;
        padding: 30px;
    }
    .password-card .form-floating {
        position: relative;
    }
    .password-card .form-floating .form-control {
        border-radius: 10px;
        border: 1.5px solid #e0e0e0;
        padding-right: 45px;
        transition: border-color 0.3s, box-shadow 0.3s;
        background: #fafafa;
    }
    .password-card .form-floating .form-control:focus {
        border-color: #88c8bc;
        box-shadow: 0 0 0 3px rgba(136,200,188,0.2);
        background: #fff;
    }
    .password-card .form-floating .form-control.is-invalid {
        border-color: #dc3545;
        box-shadow: 0 0 0 3px rgba(220,53,69,0.2);
    }
    .password-card .form-floating .form-control.is-valid {
        border-color: #28a745;
        box-shadow: 0 0 0 3px rgba(40,167,69,0.2);
    }
    .password-card .form-floating label {
        color: #6c757d;
        font-weight: 500;
        padding-left: 16px;
    }
    .password-card .form-floating .password-toggle {
        position: absolute;
        right: 14px;
        top: 30%;
        transform: translateY(-50%);
        background: transparent;
        border: none;
        color: #6c757d;
        cursor: pointer;
        font-size: 18px;
        z-index: 10;
        padding: 4px;
        transition: color 0.2s;
    }
    .password-card .form-floating .password-toggle:hover {
        color: #88c8bc;
    }
    .password-card .btn-primary {
        background: #88c8bc;
        border: none;
        border-radius: 50px;
        padding: 12px 32px;
        font-weight: 600;
        font-size: 15px;
        transition: background 0.3s, transform 0.2s;
        width: 100%;
        box-shadow: 0 4px 12px rgba(136,200,188,0.3);
    }
    .password-card .btn-primary:hover {
        background: #66a59b;
        transform: translateY(-2px);
    }
    /* Alert styles */
    .password-card .alert-container {
        margin-bottom: 20px;
    }
    .password-card .alert {
        border-radius: 10px;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        border: none;
    }
    .password-card .alert-danger {
        background: #f8d7da;
        color: #721c24;
    }
    .password-card .alert-success {
        background: #d4edda;
        color: #155724;
    }
    .password-card .alert i {
        font-size: 18px;
    }

    @media (max-width: 576px) {
        .password-card {
            padding: 20px;
        }
        .password-card .btn-primary {
            font-size: 14px;
            padding: 10px 20px;
        }
    }
</style>

<div class="password-card">
    <h4 class="mb-3 text-center">
        <i class="fas fa-key" style="color:#88c8bc;"></i>
        Change Password
    </h4>
    <p class="text-muted text-center mb-4">Enter your current password and choose a new one.</p>

    <!-- ===== Error / Success messages ===== -->
    <div class="alert-container">
        <% if (error) { %>
            <div class="alert alert-danger" role="alert">
                <i class="fas fa-exclamation-circle"></i>
                <%= error %>
            </div>
        <% } %>
        <% if (success) { %>
            <div class="alert alert-success" role="alert">
                <i class="fas fa-check-circle"></i>
                <%= success %>
            </div>
        <% } %>
        <!-- For field-specific errors, you can also highlight individual fields -->
    </div>

    <form action="/account/change-password" method="POST" id="changePasswordForm">
        <!-- Current Password -->
        <div class="form-floating mb-4">
            <input
                type="password"
                class="form-control"
                id="currentPassword"
                name="currentPassword"
                placeholder="Current Password"
                required
                autocomplete="current-password"
            >
            <label for="currentPassword">Current Password</label>
            <button type="button" class="password-toggle" data-target="currentPassword" aria-label="Toggle password visibility">
                <i class="fas fa-eye"></i>
            </button>
        </div>

        <!-- New Password -->
        <div class="form-floating mb-4">
            <input
                type="password"
                class="form-control"
                id="newPassword"
                name="newPassword"
                placeholder="New Password"
                minlength="8"
                required
                autocomplete="new-password"
            >
            <label for="newPassword">New Password</label>
            <button type="button" class="password-toggle" data-target="newPassword" aria-label="Toggle password visibility">
                <i class="fas fa-eye"></i>
            </button>
        </div>

        <!-- Confirm New Password -->
        <div class="form-floating mb-4">
            <input
                type="password"
                class="form-control"
                id="confirmPassword"
                name="confirmPassword"
                placeholder="Confirm New Password"
                minlength="8"
                required
                autocomplete="new-password"
            >
            <label for="confirmPassword">Confirm New Password</label>
            <button type="button" class="password-toggle" data-target="confirmPassword" aria-label="Toggle password visibility">
                <i class="fas fa-eye"></i>
            </button>
        </div>

        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save me-2"></i> Change Password
        </button>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // ---- Toggle password visibility (show/hide) ----
        document.querySelectorAll('.password-toggle').forEach(btn => {
            btn.addEventListener('click', function() {
                const targetId = this.dataset.target;
                const input = document.getElementById(targetId);
                const icon = this.querySelector('i');
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('fa-eye');
                    icon.classList.add('fa-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.remove('fa-eye-slash');
                    icon.classList.add('fa-eye');
                }
            });
        });
    });
</script>