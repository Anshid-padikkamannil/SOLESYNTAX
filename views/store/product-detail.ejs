<%-include("../partials/user/header")%>

<style>
	.input-number {
		width: 60px;
		text-align: center;
	}

	.product-entry img {
    width: 90%;
    height: auto;
    margin: 0 auto;
    display: block;
	}
</style>

<div id="page">

	<div class="breadcrumbs">
		<div class="container">
			<div class="row">
				<div class="col">
					<p class="bread"><span><a href="/">Home</a></span> / <span>Product Details</span></p>
				</div>
			</div>
		</div>
	</div>

	<div class="colorlib-product">
		<div class="container">
			<div class="row row-pb-lg product-detail-wrap">
				<div class="col-sm-8" >
					<div class="owl-carousel product-carousel">
						<% product.images.forEach(image => { %>
							<div class="item">
								<div class="product-entry border ">
									<a href="#" class="prod-img">
										<img 
											src="<%= image %>"
											class="img-fluid "
											alt="<%= product.productName %>"
										>
									</a>
								</div>
							</div>
						<% }) %>
					</div>
				</div>
				<div class="col-sm-4">
					<div class="product-desc">
						<h3><%= product.productName %></h3>
						<p class="price">
							<span>₹<%= product.price.toLocaleString("en-IN") %></span> 
							<span class="rate">
								<% for(let i = 1; i <= 5; i++) { %>
									<% if (product.averageRating >= i) { %>
										<i class="icon-star-full"></i>
									<% } else if (product.averageRating >= i - 0.5) { %>
										<i class="icon-star-half"></i>
									<% } else { %>
										<i class="icon-star-empty"></i>
									<% } %>
								<% } %>
								<%= product.averageRating %>/5
								(<%= product.totalReviews %> Reviews)
							</span>
						</p>
						<p><%= product.description %></p>
						<div class="size-wrap">
							<div class="block-26 mb-2">
								<h4>Size</h4>
								<ul>
									<% product.sizes.forEach(size => { %>
										<li>
											<a href="#" class="size-option" data-size="<%= size %>"><%= size %></a>
										</li>
									<% }) %>
								</ul>
							</div>
						</div>
						<div class="input-group mb-4">
							<span class="input-group-btn">
								<button type="button" class="quantity-left-minus btn" data-type="minus" data-field="">
									<i class="icon-minus2"></i>
								</button>
							</span>
							<input type="text" id="quantity" name="quantity" class="input-number" value="1" min="1" max="<%= Math.min(10,product.stock) %>">
							<span class="input-group-btn ml-1">
								<button type="button" class="quantity-right-plus btn" data-type="plus" data-field="">
									<i class="icon-plus2"></i>
								</button>
							</span>
						</div>
						<div class="row">
							<div class="col-sm-12 text-center">
								<p class="addtocart"><button id="addToCartBtn" class="btn btn-primary btn-addtocart" data-product-id="<%= product._id %>"><i class="icon-shopping-cart"></i> Add to Cart</button></p>
							</div>
						</div>
					</div>
				</div>
			</div>

