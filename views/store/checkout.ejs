<!DOCTYPE html>
<html lang="en">
<head>
    <title>Checkout | SOLESYNTAX</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Montserrat:300,400,500,600,700" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Rokkitt:100,300,400,700" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Bootstrap 4 -->
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <!-- Icomoon (for cart icon) -->
    <link rel="stylesheet" href="/css/icomoon.css">
    <!-- Your custom theme styles -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/account.css">

    <!-- jQuery UI (for datepicker, if used) -->
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
</head>
<body>

  <style>
    /* ===== Brand Colors ===== */
    /* ===== FORCE BRAND PRIMARY ===== */
    :root {
      --bs-primary: #88c8bc !important;
      --bs-primary-rgb: 136, 200, 188 !important;
      --primary: #88c8bc !important;
    }

    .btn-primary,
    .btn-outline-primary, 
    .bg-primary,
    .text-primary,
    .badge.bg-primary,
    .btn-apply,
    .available-coupons-toggle,
    .view-all-link,
    .manage-address-link {
      color: #88c8bc !important;
      border-color: #88c8bc !important;
    }

    .bg-primary,
    .badge.bg-primary,
    .btn-primary {
      background-color: #88c8bc !important;
      color: #fff !important;
    }

    .btn-outline-primary:hover,
    .btn-primary:hover {
      background-color: #66a59b !important;
      border-color: #66a59b !important;
      color: #fff !important;
    }

    .btn-outline-primary {
      color: #88c8bc !important;
    }

    /* Fix for "Change" button text */
    .address-card .btn-outline-primary {
      color: #88c8bc !important;
    }
    .address-card .btn-outline-primary:hover {
      color: #fff !important;
    }

    .manage-address-link {
      color: #88c8bc !important;
    }
    .manage-address-link:hover {
      color: #66a59b !important;
    }
    :root {
      --primary: #88c8bc;
      --primary-dark: #66a59b;
      --secondary: #46698f;
      --accent: #ff6b6b;
      --gold: #f5a623;
      --light: #f8f9fa;
      --dark: #1a1a2e;
      --shadow: 0 8px 40px rgba(0, 0, 0, 0.08);
      --border-radius: 16px;
    }

    /* ===== Override Bootstrap Primary Color ===== */
    :root {
      --bs-primary: #88c8bc;
      --bs-primary-rgb: 136, 200, 188;
    }

    .btn-primary {
      background-color: var(--bs-primary) !important;
      border-color: var(--bs-primary) !important;
    }
    .btn-primary:hover {
      background-color: #66a59b !important;
      border-color: #66a59b !important;
    }
    .btn-outline-primary {
      color: var(--bs-primary) !important;
      border-color: var(--bs-primary) !important;
    }
    .btn-outline-primary:hover {
      background-color: var(--bs-primary) !important;
      border-color: var(--bs-primary) !important;
      color: #fff !important;
    }
    .text-primary {
      color: var(--bs-primary) !important;
    }
    .bg-primary {
      background-color: var(--bs-primary) !important;
    }

    /* ===== Global ===== */
    * { box-sizing: border-box; }

    body {
      font-family: 'Poppins', sans-serif;
      background: #f0f2f5;
      color: #333;
      padding: 0;
      margin: 0;
    }

    /* .usp-banner {
      background: linear-gradient(135deg, var(--primary), var(--primary-dark));
      padding: 12px 0;
      color: #fff;
      font-size: 14px;
      font-weight: 500;
      text-align: center;
      letter-spacing: 0.3px;
    }
    .usp-banner span {
      display: inline-block;
      margin: 0 20px;
    }
    .usp-banner i {
      margin-right: 6px;
      font-size: 16px;
    }
    @media (max-width: 576px) {
      .usp-banner span { display: block; margin: 4px 0; }
    } */

    .breadcrumb {
      background: transparent;
      padding: 14px 0 6px;
      font-size: 14px;
      margin-bottom: 0;
    }
    .breadcrumb-item a { color: var(--primary); text-decoration: none; font-weight: 500; }
    .breadcrumb-item.active { color: #6c757d; }

    .checkout-wrapper {
      max-width: 1200px;
      margin: 10px auto 50px;
      padding: 0 20px;
    }

    .checkout-header {
      text-align: center;
      margin-bottom: 30px;
      animation: fadeDown 0.6s ease;
    }
    .checkout-header h2 {
      font-family: 'Rokkitt', Georgia, serif;
      font-size: 38px;
      font-weight: 700;
      color: var(--dark);
      letter-spacing: -0.5px;
    }
    .checkout-header h2 i { color: var(--primary); }
    .checkout-header p { color: #6c757d; font-size: 16px; margin-top: 2px; }

    .checkout-steps {
      display: flex;
      justify-content: center;
      gap: 2.5rem;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }
    .step {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 500;
      color: #adb5bd;
      font-size: 14px;
      transition: all 0.3s;
      position: relative;
    }
    .step .step-number {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: #e9ecef;
      color: #6c757d;
      font-weight: 700;
      transition: all 0.4s ease;
      font-size: 14px;
    }
    .step.active .step-number {
      background: var(--primary);
      color: #fff;
      box-shadow: 0 4px 14px rgba(136,200,188,0.4);
      transform: scale(1.08);
    }
    .step.completed .step-number {
      background: var(--primary-dark);
      color: #fff;
    }
    .step.active { color: var(--dark); }
    .step.completed { color: var(--primary-dark); }

    .checkout-section {
      background: #fff;
      border-radius: var(--border-radius);
      box-shadow: var(--shadow);
      padding: 28px 30px;
      margin-bottom: 24px;
      transition: transform 0.25s ease, box-shadow 0.3s ease;
      animation: fadeUp 0.6s ease;
    }
    .checkout-section:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 48px rgba(0,0,0,0.10);
    }
    .checkout-section h5 {
      font-weight: 700;
      font-size: 18px;
      color: var(--dark);
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .checkout-section h5 i { color: var(--primary); font-size: 20px; }

    /* ===== ADDRESS CARD ===== */
    .address-card {
      background: #f8fffe;
      border: 1.5px solid var(--primary);
      border-radius: 12px;
      padding: 20px 24px;
      transition: all 0.3s;
      position: relative;
    }
    .address-card .default-badge {
      position: absolute;
      top: -10px;
      right: 20px;
      background: var(--primary);
      color: #fff;
      font-size: 11px;
      font-weight: 700;
      padding: 2px 16px;
      border-radius: 50px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }
    .address-card .address-icon {
      font-size: 24px;
      color: var(--primary);
      margin-right: 12px;
    }
    .address-card .address-details {
      flex: 1;
    }
    .address-card .address-details .name {
      font-weight: 600;
      color: var(--dark);
      font-size: 16px;
    }
    .address-card .address-details .addr {
      color: #555;
      font-size: 14px;
      line-height: 1.6;
    }
    .address-card .address-details .phone {
      color: #6c757d;
      font-size: 13px;
    }
    .address-card .address-details .phone i {
      color: var(--primary);
      width: 18px;
    }

    .manage-address-link {
      color: var(--primary) !important;
      font-weight: 500;
      text-decoration: none;
    }
    .manage-address-link:hover {
      color: var(--primary-dark) !important;
      text-decoration: underline;
    }

    /* ===== DELIVERY ESTIMATE ===== */
    .delivery-estimate {
      background: #f0f9f7;
      border-radius: 10px;
      padding: 12px 18px;
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 14px;
      border-left: 4px solid var(--primary);
    }
    .delivery-estimate i {
      font-size: 22px;
      color: var(--primary);
    }
    .delivery-estimate .delivery-text {
      font-size: 14px;
      color: #555;
    }
    .delivery-estimate .delivery-text strong {
      color: var(--dark);
    }

    /* ===== PAYMENT ===== */
    .payment-option {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 18px;
      border: 2px solid #e9ecef;
      border-radius: 12px;
      margin-bottom: 12px;
      cursor: pointer;
      transition: all 0.3s ease;
      background: #fafafa;
    }
    .payment-option:hover {
      border-color: var(--primary);
      background: #f8fffe;
      transform: translateX(4px);
    }
    .payment-option.active {
      border-color: var(--primary);
      background: rgba(136,200,188,0.08);
      box-shadow: 0 0 0 3px rgba(136,200,188,0.12);
    }
    .payment-option input[type="radio"] {
      accent-color: var(--primary);
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }
    .payment-option label {
      cursor: pointer;
      font-weight: 500;
      font-size: 15px;
      margin: 0;
      flex: 1;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .payment-option label i {
      font-size: 22px;
      color: #6c757d;
      width: 30px;
    }

    /* ===== WHY SHOP WITH US ===== */
    .usp-grid .usp-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 12px;
      background: #fafafa;
      border-radius: 10px;
      transition: background 0.2s;
    }
    .usp-grid .usp-item:hover {
      background: #f0f9f7;
    }
    .usp-grid .usp-item i {
      font-size: 22px;
      color: var(--primary);
      width: 30px;
      text-align: center;
    }
    .usp-grid .usp-item .usp-text {
      font-size: 14px;
    }
    .usp-grid .usp-item .usp-text strong {
      display: block;
      font-weight: 600;
      color: var(--dark);
    }
    .usp-grid .usp-item .usp-text small {
      color: #6c757d;
      font-size: 12px;
    }

    /* ===== ORDER SUMMARY ===== */
    .order-summary { position: sticky; top: 20px; }
    .order-summary .checkout-section { padding: 24px; }

    .order-item {
      display: flex;
      gap: 14px;
      padding: 12px 0;
      border-bottom: 1px solid #f0f0f0;
      align-items: center;
      transition: background 0.2s;
    }
    .order-item:last-child { border-bottom: none; }
    .order-item img {
      width: 56px;
      height: 56px;
      object-fit: cover;
      border-radius: 10px;
      background: #f0f0f0;
      transition: transform 0.3s;
    }
    .order-item:hover img { transform: scale(1.05); }
    .order-item .details { flex: 1; }
    .order-item .details .name { font-weight: 600; color: var(--dark); font-size: 15px; }
    .order-item .details .meta { font-size: 13px; color: #6c757d; }
    .order-item .price { font-weight: 700; color: var(--primary-dark); }

    .totals { margin-top: 18px; }
    .totals .row {
      display: flex;
      justify-content: space-between;
      padding: 6px 0;
      font-size: 15px;
      color: #495057;
    }
    .totals .row .label { font-weight: 500; }
    .totals .row .value { font-weight: 600; }
    .totals .grand-total {
      border-top: 2px solid #e9ecef;
      margin-top: 12px;
      padding-top: 16px;
    }
    .totals .grand-total .label {
      font-size: 18px;
      font-weight: 700;
      color: var(--dark);
    }
    .totals .grand-total .value {
      font-size: 26px;
      font-weight: 800;
      color: var(--primary-dark);
    }

    /* ===== COUPON ===== */
    .coupon-section {
      margin: 16px 0 12px;
      padding-top: 10px;
      border-top: 1px dashed #e9ecef;
    }
    .coupon-form {
      display: flex;
      gap: 8px;
    }
    .coupon-form .btn-apply {
      background: var(--primary) !important;
      border: none !important;
      color: #fff !important;
      font-weight: 600;
      padding: 0 20px;
      border-radius: 50px;
      transition: all 0.3s;
      white-space: nowrap;
    }
    .coupon-form .btn-apply:hover {
      background: var(--primary-dark) !important;
      transform: scale(1.03);
    }

    .available-coupons-toggle {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--primary);
      font-weight: 500;
      font-size: 14px;
      cursor: pointer;
      transition: color 0.2s;
      margin-top: 8px;
    }
    .available-coupons-toggle:hover { color: var(--primary-dark); }
    .available-coupons-toggle i { font-size: 14px; }

    /* Smooth coupon list toggle */
    .coupon-list-wrapper {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.5s ease;
      opacity: 0;
    }
    .coupon-list-wrapper.open {
      max-height: 600px; /* large enough to contain all coupons */
      opacity: 1;
    }

    .coupon-list {
      background: #f8f9fa;
      border-radius: 10px;
      padding: 12px 16px;
      margin-top: 10px;
      border: 1px solid #e9ecef;
    }
    .coupon-list .coupon-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 6px 0;
      border-bottom: 1px dashed #e9ecef;
      font-size: 14px;
    }
    .coupon-list .coupon-item:last-child { border-bottom: none; }
    .coupon-list .coupon-item .code {
      font-weight: 700;
      font-family: 'Courier New', monospace;
      color: var(--secondary);
      letter-spacing: 0.5px;
    }
    .coupon-list .coupon-item .discount {
      font-weight: 600;
      color: var(--primary-dark);
    }
    .view-all-link {
      display: block;
      text-align: center;
      margin-top: 10px;
      font-weight: 500;
      color: var(--primary);
      text-decoration: none;
      font-size: 14px;
    }
    .view-all-link:hover { color: var(--primary-dark); text-decoration: underline; }

    .btn-place-order {
      width: 100%;
      background: linear-gradient(135deg, #88c8bc, #66a59b) !important;
      border: none !important;
      color: #fff;
      padding: 18px;
      font-size: 18px;
      font-weight: 700;
      border-radius: 50px;
      transition: all 0.4s ease;
      margin-top: 18px;
      letter-spacing: 0.5px;
      box-shadow: 0 4px 20px rgba(136,200,188,0.35) !important;
      position: relative;
      overflow: hidden;
    }
    .btn-place-order:hover {
      background: linear-gradient(135deg, #66a59b, #4d8a7d) !important;
      box-shadow: 0 8px 30px rgba(136,200,188,0.5) !important;
      transform: scale(1.03);
    }
    .btn-place-order::after {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 60%);
      opacity: 0;
      transition: opacity 0.6s;
      pointer-events: none;
    }
    .btn-place-order:hover::after { opacity: 1; }
    .btn-place-order i { margin-right: 10px; }
    .btn-place-order:active { transform: scale(0.97); }

    .secure-badge {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      color: #6c757d;
      font-size: 13px;
      margin-top: 16px;
    }
    .secure-badge i { color: var(--primary); font-size: 18px; }

    .confetti-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 9999;
      overflow: hidden;
    }
    .confetti-piece {
      position: absolute;
      width: 10px;
      height: 10px;
      opacity: 0;
      animation: confettiFall 2.5s ease-in forwards;
    }

    /* ===== COUPON SUCCESS ANIMATION ===== */
    @keyframes savePulse {
      0% { background-color: rgba(40, 167, 69, 0); transform: scale(1); }
      30% { background-color: rgba(40, 167, 69, 0.15); transform: scale(1.02); }
      70% { background-color: rgba(40, 167, 69, 0.05); transform: scale(0.98); }
      100% { background-color: transparent; transform: scale(1); }
    }
    .save-flash {
      animation: savePulse 0.8s ease 2;
    }

    @keyframes badgePop {
      0% { transform: scale(0); opacity: 0; }
      70% { transform: scale(1.2); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }
    .save-badge {
      display: inline-block;
      background: #28a745;
      color: #fff;
      font-weight: 700;
      font-size: 13px;
      padding: 2px 12px;
      border-radius: 50px;
      animation: badgePop 0.5s ease forwards;
      margin-left: 8px;
      vertical-align: middle;
    }

    @keyframes numberPop {
      0% { transform: scale(1); }
      30% { transform: scale(1.15); color: #28a745; }
      70% { transform: scale(0.95); }
      100% { transform: scale(1); color: var(--primary-dark); }
    }
    .total-pop {
      animation: numberPop 0.6s ease;
    }
    @keyframes confettiFall {
      0% { opacity: 1; transform: translateY(-10px) rotate(0deg) scale(1); }
      100% { opacity: 0; transform: translateY(100vh) rotate(720deg) scale(0.3); }
    }

    @keyframes fadeDown {
      0% { opacity: 0; transform: translateY(-20px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeUp {
      0% { opacity: 0; transform: translateY(20px); }
      100% { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 992px) {
      .order-summary { position: static; margin-top: 24px; }
    }
    @media (max-width: 768px) {
      .checkout-steps { gap: 1rem; }
      .checkout-section { padding: 20px; }
      .payment-option { padding: 12px 14px; }
    }
    @media (max-width: 576px) {
      .checkout-header h2 { font-size: 28px; }
      .order-item img { width: 48px; height: 48px; }
      .totals .grand-total .value { font-size: 22px; }
    }
  </style>

<%- include("../partials/user/header", { activePage: 'checkout' }) %>

