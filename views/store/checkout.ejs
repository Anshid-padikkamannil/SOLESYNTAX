</div> -->

<!-- ===== CHECKOUT ===== -->
<div class="checkout-wrapper">
  <div class="checkout-header">
    <h2><i class="fas fa-lock"></i> Secure Checkout</h2>
    <p>Complete your purchase in just a few steps</p>
  </div>

  <!-- Progress Steps -->
  <div class="checkout-steps">
    <span class="step completed"><span class="step-number"><i class="fas fa-check"></i></span> Cart</span>
    <span class="step active"><span class="step-number">2</span> Details</span>
    <span class="step"><span class="step-number">3</span> Payment</span>
    <span class="step"><span class="step-number">4</span> Confirm</span>
  </div>

  <div class="row g-4">
    <!-- Left Column -->
    <div class="col-lg-8">
      <!-- ===== Shipping Address ===== -->
      <div class="checkout-section">
        <h5><i class="fas fa-map-pin"></i> Shipping Address</h5>

        <div class="address-card">
          <% if (addresses && addresses.length > 0) { %>
            <% addresses.forEach(addr => { %>
              <% if (addr.isDefault) { %>
                <div class="d-flex align-items-start mb-3">
                  <span class="default-badge">Default</span>
                  <i class="fas fa-<%= addr.addressType === 'Work' ? 'briefcase' : addr.addressType === 'Other' ? 'map-marker-alt' : 'home' %> address-icon"></i>
                  <div class="address-details">
                    <div class="name"><%= addr.name %></div>
                    <div class="addr">
                      <%= addr.addressLine1 %><br>
                      <% if (addr.addressLine2) { %>
                        <%= addr.addressLine2 %><br>
                      <% } %>
                      <%= addr.city %>, <%= addr.state %> - <%= addr.pincode %>
                    </div>
                    <div class="phone"><i class="fas fa-phone"></i> <%= addr.phone %></div>
                  </div>
                  <a href="/account/addresses" class="btn btn-sm btn-outline-primary ms-3 flex-shrink-0">
                    <i class="fas fa-edit"></i> Change
                  </a>
                </div>
              <% } %>
            <% }); %>
          <% } else { %>
            <p>No addresses found. Please add one.</p>
          <% } %>
        </div>

        <!-- Delivery Estimate -->
        <div class="delivery-estimate">
          <i class="fas fa-truck"></i>
          <div class="delivery-text">
            <strong>Estimated Delivery:</strong> 3-5 business days · 
            <span class="text-success">Free Shipping</span>
          </div>
        </div>

        <p class="text-muted small mb-0 mt-2">
          <i class="fas fa-info-circle"></i> Need to add or edit an address? 
          <a href="/account/addresses" class="manage-address-link">Manage addresses</a>
        </p>
      </div>

      <!-- ===== Payment ===== -->
      <div class="checkout-section">
        <h5><i class="fas fa-credit-card"></i> Payment Method</h5>

        <!-- Razorpay -->
        <div class="payment-option active">
          <input type="radio" name="payment" id="pay-razorpay" checked>
          <label for="pay-razorpay">
            <i class="fas fa-credit-card" style="font-size:22px; width:30px; color:var(--primary);"></i>
            <span>Razorpay</span>
            <span class="text-muted" style="font-size:13px;">(Credit/Debit Card, UPI, Net Banking)</span>
          </label>
        </div>

        <!-- Cash on Delivery -->
        <div class="payment-option">
          <input type="radio" name="payment" id="pay-cod">
          <label for="pay-cod">
            <i class="fas fa-truck" style="font-size:22px; width:30px; color:var(--primary);"></i>
            <span>Cash on Delivery</span>
            <span class="text-muted" style="font-size:13px;">Pay when you receive</span>
          </label>
        </div>
      </div>

      <!-- ===== WHY SHOP WITH US ===== -->
      <div class="checkout-section">
        <h5><i class="fas fa-shield-alt"></i> Why Shop With Us</h5>
        <div class="row g-2 usp-grid">
          <div class="col-6">
            <div class="usp-item">
              <i class="fas fa-truck"></i>
              <div class="usp-text">
                <strong>Free Shipping</strong>
                <small>On orders over ₹5000</small>
              </div>
            </div>
          </div>
          <div class="col-6">
            <div class="usp-item">
              <i class="fas fa-undo-alt"></i>
              <div class="usp-text">
                <strong>Easy Returns</strong>
                <small>30‑day return policy</small>
              </div>
            </div>
          </div>
          <div class="col-6">
            <div class="usp-item">
              <i class="fas fa-lock"></i>
              <div class="usp-text">
                <strong>Secure Payment</strong>
                <small>256‑bit encryption</small>
              </div>
            </div>
          </div>
          <div class="col-6">
            <div class="usp-item">
              <i class="fas fa-headset"></i>
              <div class="usp-text">
                <strong>24/7 Support</strong>
                <small>We’re here to help</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column – Order Summary -->
    <div class="col-lg-4">
      <div class="order-summary">
        <div class="checkout-section">
          <h5><i class="fas fa-receipt"></i> Order Summary</h5>

          <!-- Dynamic Cart Items -->
          <% if (cart && cart.items.length > 0) { %>
           <% cart.items.forEach(item => { %>
            <a href="/cart">
              <div class="order-item">
                <img src="<%= item.productId.images[0] %>" alt="<%= item.productId.productName %>">
                <div class="details">
                  <div class="name"><%= item.productId.productName %></div>
                  <div class="meta">Size: <%= item.size %>, Qty: <%= item.quantity %></div>
                </div>
                <div class="price">₹<%= (item.productId.price * item.quantity).toLocaleString('en-IN') %></div>
              </div>
            </a>  
            <% }) %>
          <% } else { %>
            <p class="text-muted">Your cart is empty.</p>
          <% } %>

          <!-- Totals -->
          <div class="totals">
            <div class="row">
              <span class="label">Subtotal</span>
              <span class="value" id="subtotal">₹<%= subtotal ? subtotal.toLocaleString('en-IN') : 0 %></span>
            </div>
            <div class="row">
              <span class="label">Shipping</span>
              <span class="value" id="shipping">₹<%= shipping || 0 %></span>
            </div>
            <div class="row">
              <span class="label">Discount</span>
              <span class="value" id="discount">−₹<%= discount || 0 %></span>
            </div>
          </div>

          <!-- ===== COUPON (smooth toggle) ===== -->
          <div class="coupon-section">
            <div class="coupon-form d-flex gap-2">
              <input type="text" class="form-control form-control-sm" placeholder="Coupon code" id="couponInput">
              <button class="btn btn-apply" id="applyCoupon">Apply</button>
            </div>

            <div class="available-coupons-toggle" id="couponToggle">
              <i class="fas fa-ticket-alt"></i>
              Available coupons <span class="badge bg-primary" style="font-size:12px;"><%= coupons ? coupons.filter(c => c.status && c.status.toLowerCase() === 'available').length : 0 %></span>
              <i class="fas fa-chevron-down" style="font-size:12px; margin-left:4px;" id="couponChevron"></i>
            </div>

            <div class="coupon-list-wrapper" id="couponListWrapper">
              <div class="coupon-list">
                <% if (coupons && coupons.length) { %>
                  <% coupons.forEach(coupon => { %>
                    <% if (coupon.status && coupon.status.toLowerCase() === 'available') { %>
                      <div class="coupon-item">
                        <span class="code"><%= coupon.code %></span>
                        <span class="discount"><%= coupon.discount %></span>
                        <button class="btn btn-sm btn-outline-primary" onclick="document.getElementById('couponInput').value='<%= coupon.code %>';">Apply</button>
                      </div>
                    <% } %>
                  <% }) %>
                <% } else { %>
                  <p class="text-muted small mb-0">No coupons available.</p>
                <% } %>
                <a href="/account/coupons" class="view-all-link">
                  <i class="fas fa-arrow-right"></i> View all coupons
                </a>
              </div>
            </div>
          </div>

          <!-- Grand Total -->
          <div class="totals">
            <div class="row grand-total">
              <span class="label">Total</span>
              <span class="value" id="grandTotal">₹<%= finalAmount ? finalAmount.toLocaleString('en-IN') : 0 %></span>
            </div>
          </div>

          <!-- Place Order -->
          <button class="btn-place-order" id="placeOrderBtn"><i class="fas fa-lock"></i> Place Order</button>
          <div class="secure-badge">
            <i class="fas fa-shield-alt"></i> 256‑bit encrypted · Secure payment
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include("../partials/account/footer") %>

<!-- ===== SCRIPTS ===== -->
 <!-- <script src="/js/notifications.js"></script> -->
	<script src="https://cdnjs.cloudflare.com/ajax/libs/waypoints/4.0.1/jquery.waypoints.min.js"></script>
	<script src="/js/jquery.flexslider-min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  (function() {
    'use strict';

    // ---- TEMPORARY TOAST (if notifications.js is not loaded) ----
    if (typeof showToast === 'undefined') {
      window.showToast = function(message, type, icon) {
        alert(message);
      };
    }

    // ---- Payment toggle ----
    const radios = document.querySelectorAll('input[name="payment"]');
    radios.forEach(r => {
      r.addEventListener('change', function() {
        document.querySelectorAll('.payment-option').forEach(el => el.classList.remove('active'));
        this.closest('.payment-option').classList.add('active');
      });
    });

    // ---- Coupon apply ----
    let appliedCouponCode = null;
    
    document.getElementById('applyCoupon').addEventListener('click', async function() {
      const input = document.getElementById('couponInput');
      const code = input.value.trim();

      if (!code) {
        showToast('Please enter a coupon code.', 'warning', '⚠️');
        return;
      }

      try {
        const response = await fetch('/checkout/coupon', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ couponCode: code })
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          showToast(result.message || 'Unable to apply coupon.', 'warning', '⚠️');
          return;
        }

        appliedCouponCode = result.appliedCouponCode;

        // ---- Get DOM elements ----
        const discountEl = document.getElementById('discount');
        const shippingEl = document.getElementById('shipping');
        const grandTotalEl = document.getElementById('grandTotal');

        // ---- Update totals ----
        discountEl.textContent = '−₹' + result.discount.toLocaleString('en-IN');
        shippingEl.textContent = '₹' + result.shipping.toLocaleString('en-IN');
        grandTotalEl.textContent = '₹' + result.finalAmount.toLocaleString('en-IN');

        // ========================================================
        //  EFFECTS
        // ========================================================

        // 1. Pulse the discount row
        const discountRow = discountEl.closest('.row');
        if (discountRow) {
          discountRow.classList.remove('save-flash');
          void discountRow.offsetWidth;
          discountRow.classList.add('save-flash');
        }

        // 2. Animate the grand total
        grandTotalEl.classList.remove('total-pop');
        void grandTotalEl.offsetWidth;
        grandTotalEl.classList.add('total-pop');

        // 3. Green border flash on coupon input
        const couponInput = document.getElementById('couponInput');
        couponInput.style.transition = 'border-color 0.3s, box-shadow 0.3s';
        couponInput.style.borderColor = '#28a745';
        couponInput.style.boxShadow = '0 0 0 3px rgba(40,167,69,0.25)';
        setTimeout(() => {
          couponInput.style.borderColor = '';
          couponInput.style.boxShadow = '';
        }, 2000);

        // 4. Floating ₹ coins from the discount row (single colour)
        if (discountRow) {
          const rect = discountRow.getBoundingClientRect();
          const coinCount = 18;
          const coinColor = '#88c8bc'; // ← change this to any single colour you like
          for (let i = 0; i < coinCount; i++) {
            const coin = document.createElement('div');
            coin.textContent = '₹';
            const size = 20 + Math.random() * 18;
            const startX = rect.left + Math.random() * rect.width;
            const startY = rect.top + 10;
            const angle = (Math.random() - 0.5) * 1.2;
            const distance = 80 + Math.random() * 150;
            const dx = Math.sin(angle) * distance;
            const dy = -Math.cos(angle) * distance - 40;
            const rotation = (Math.random() - 0.5) * 360;
            coin.style.cssText = `
              position: fixed;
              left: ${startX}px;
              top: ${startY}px;
              font-size: ${size}px;
              color: ${coinColor};
              font-weight: 700;
              pointer-events: none;
              z-index: 9999;
              opacity: 1;
              transition: all 1.2s cubic-bezier(0.2, 0.8, 0.4, 1);
            `;
            document.body.appendChild(coin);
            requestAnimationFrame(() => {
              coin.style.transform = `translate(${dx}px, ${dy}px) rotate(${rotation}deg)`;
              coin.style.opacity = '0';
            });
            setTimeout(() => coin.remove(), 1500);
          }
        }

      } catch (err) {
        console.error('COUPON ERROR:', err);
        showToast('Something went wrong while applying the coupon.', 'warning', '⚠️');
      }
    });

    // ---- Smooth coupon toggle ----
    const toggleBtn = document.getElementById('couponToggle');
    const wrapper = document.getElementById('couponListWrapper');
    const chevron = document.getElementById('couponChevron');

    if (toggleBtn && wrapper) {
      toggleBtn.addEventListener('click', function() {
        const isOpen = wrapper.classList.contains('open');
        if (isOpen) {
          wrapper.classList.remove('open');
          chevron.classList.remove('fa-chevron-up');
          chevron.classList.add('fa-chevron-down');
        } else {
          wrapper.classList.add('open');
          chevron.classList.remove('fa-chevron-down');
          chevron.classList.add('fa-chevron-up');
        }
      });
    }

    // ---- Place Order ----

    // ---- Resume Pending Razorpay Payment ----
    async function resumeRazorpayPayment(orderId) {
      try {
        
        const response = await fetch('/checkout/create-order', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            orderId
          })
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(
            result.message || 'Unable to resume payment.'
          );
        }

        const options = {
          key: result.key_id,
          amount: result.order.amount,
          currency: result.order.currency,
          name: 'SOLESYNTAX',
          description: 'Order Payment',
          order_id: result.order.id,

          handler: async function (paymentResponse) {
            try {
              
              const verifyResponse = await fetch('/checkout/verify', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                razorpay_order_id: paymentResponse.razorpay_order_id,
                razorpay_payment_id: paymentResponse.razorpay_payment_id,
                razorpay_signature: paymentResponse.razorpay_signature,
                appOrderId: orderId
                })
              });

              const verifyResult = await verifyResponse.json();

              if (!verifyResponse.ok) {
                throw new Error(
                  verifyResult.message || 'Payment verification failed.'
                );
              }

              if (verifyResult.success !== true) {
                throw new Error(
                  verifyResult.message || 'Payment verification failed.'
                );
              }
              launchConfetti();

              setTimeout(() => {
                window.location.href =
                  `/account/order-details/${orderId}`;
              }, 3000);

            } catch (err) {
              console.error('RESUMED PAYMENT VERIFICATION ERROR:',err);

              Swal.fire({
                icon: 'error',
                title: 'Payment Verification Failed',
                text:
                  err.message ||
                  'Payment was completed, but verification failed.',
                confirmButtonColor: '#88c8bc'
              });
            }
          },
          modal: {
            ondismiss: function() {

              Swal.fire({
                icon: 'warning',
                title: 'Payment Not Completed',
                text: 'You can resume this payment anytime.',
                confirmButtonColor: '#88c8bc'
              });
            }
          },
          
          theme: {
            color: '#88c8bc'
          }
        }

        const razorpay = new Razorpay(options);
        
        razorpay.open();

      } catch (error) {
        console.error('RESUME PAYMENT ERROR:', error);

        Swal.fire({
          icon: 'error',
          title: 'Unable to Resume Payment',
          text:
            error.message ||
            'Something went wrong while resuming payment.',
          confirmButtonColor: '#88c8bc'
        });
        
      }
    }

    document.getElementById('placeOrderBtn').addEventListener('click', async function () {
      const button = this;

      const selected = document.querySelector('input[name="payment"]:checked');

      if (!selected) {
        alert('Please select a payment method.');
        return;
      }

      const paymentMethod =
        selected.id === 'pay-cod' ? 'COD' : 'Razorpay';

      // Get applied coupon
      const couponInput = document.getElementById('couponInput');
      const couponCode = couponInput.value.trim();

      try {
        // Prevent double-clicking
        button.disabled = true;
        button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Placing Order...';

        const response = await fetch('/order', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            paymentMethod,
            ...(couponCode ? { couponCode } : {})
          })
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          const error = new Error(
            result.message || 'Unable to place order.'
          );

          error.pendingOrderId = result.pendingOrderId;

          throw error;
        }

        // COD
        // -------------------------------- //
        if (paymentMethod === 'COD') {
          // Order successfully created
          launchConfetti();

          // Wait for confetti to be visible
          setTimeout(() => {
            window.location.href = `/account/order-details/${result.orderId}`;
          }, 3500);

          return;
        }

        // RAZORPAY
        // -------------------------------- //

        const razorpayResponse = await fetch('/checkout/create-order', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            orderId: result.orderId
          })
        });

        const razorpayResult = await razorpayResponse.json();

        if (!razorpayResponse.ok || !razorpayResult.success) {
          throw new Error( razorpayResult.message || 'Unable to create Razorpay order');
        }

        // Open Razorpay Checkout
        const options = {
          key: razorpayResult.key_id,
          amount: razorpayResult.order.amount,
          currency: razorpayResult.order.currency,
          name: 'SOLESYNTAX',
          description: 'Order Payment',
          order_id: razorpayResult.order.id,

          handler: async function (response) {

            try {
              
              const verifyResponse = await fetch('/checkout/verify', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                  razorpay_order_id: response.razorpay_order_id,
                  razorpay_payment_id: response.razorpay_payment_id,
                  razorpay_signature: response.razorpay_signature,
                  appOrderId: result.orderId
                })
              });

              const verifyResult = await verifyResponse.json();

              if (!verifyResponse.ok || !verifyResult.success) {
                throw new Error(verifyResult.message || 'Payment verification failed');
              }

              launchConfetti();

              setTimeout(() => {
                window.location.href = `/account/order-details/${result.orderId}`;
              }, 3000)

            } catch (err) {
              
              console.error('PAYMENT VERIFICATION ERROR:', err);

              Swal.fire({
                icon: 'error',
                title: 'Payment Verification Failed',
                text:
                  err.message ||
                  'Payment was completed, but verification failed.',
                confirmButtonColor: '#88c8bc'
              });

              button.disabled = false;
              button.innerHTML = '<i class="fas fa-lock"></i> Place Order';
            }
          },

          modal: {
            ondismiss: function() {

              showToast('Payment was not completed. You can try again.', 'warning');

              button.disabled = false;
              button.innerHTML = '<i class="fas fa-lock"></i> Place Order';
            }
          },

          theme: {
            color: '#88c8bc'
          }
        }
        const razorpay = new Razorpay(options);

        razorpay.open();

      } catch (error) {
        console.error('ORDER ERROR:', error);

        if (error.pendingOrderId) {
          Swal.fire({
            icon: 'warning',
            title: 'Pending Payment',
            text: error.message,
            showCancelButton: true,
            confirmButtonText: 'Resume Payment',
            cancelButtonText: 'Close',
            confirmButtonColor: '#88c8bc',
            cancelButtonColor: '#6c757d'
          }).then((result) => {

            if (result.isConfirmed) {
              resumeRazorpayPayment(error.pendingOrderId);
            }

          });

        } else {

          Swal.fire({
            icon: 'error',
            title: 'Unable to Place Order',
            text: error.message || 'Something went wrong.',
            confirmButtonText: 'OK',
            confirmButtonColor: '#88c8bc'
          });
        }

        button.disabled = false;
        button.innerHTML = '<i class="fas fa-lock"></i> Place Order';
      }
    });

    // ---- Confetti ----
    function launchConfetti() {
      const container = document.createElement('div');
      container.className = 'confetti-container';
      document.body.appendChild(container);

      const colors = ['#ff6b6b', '#f5a623', '#88c8bc', '#46698f', '#ff6b6b', '#f5a623', '#88c8bc', '#ff6b6b'];
      const shapes = ['■', '●', '▲', '★', '♦'];

      for (let i = 0; i < 80; i++) {
        const piece = document.createElement('span');
        piece.className = 'confetti-piece';
        piece.textContent = shapes[Math.floor(Math.random() * shapes.length)];
        piece.style.color = colors[Math.floor(Math.random() * colors.length)];
        piece.style.fontSize = (12 + Math.random() * 20) + 'px';
        piece.style.left = (Math.random() * 100) + '%';
        piece.style.top = '-10px';
        piece.style.animationDelay = (Math.random() * 0.8) + 's';
        piece.style.transform = 'rotate(' + (Math.random() * 360) + 'deg)';
        container.appendChild(piece);
      }

      setTimeout(() => { container.remove(); }, 3500);
    }

  })();
</script>

</body>
</html>