<!-- views/wishlist.ejs -->
<%- include('../partials/user/header') %>

<style>
  /* ===== Brand Colors ===== */
  :root {
    --primary: #88c8bc;
    --primary-dark: #66a59b;
    --secondary: #46698f;
    --accent: #ff6b6b;
    --light: #f8f9fa;
    --dark: #343a40;
    --gray-light: #e9ecef;
    --gray: #ced4da;
    --shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
    --border-radius: 10px;
    --font-main: 'Poppins', sans-serif;
  }

  .main-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 30px 20px;
  }

  .wishlist-header {
    text-align: center;
    margin-bottom: 30px;
  }
  .wishlist-header h2 {
    font-family: 'Rokkitt', Georgia, serif;
    font-size: 32px;
    font-weight: 600;
    color: var(--dark);
    margin-bottom: 5px;
  }
  .wishlist-header p {
    color: #6c757d;
    font-size: 16px;
  }

  .wishlist-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 25px;
  }
  .clear-btn {
    background: var(--accent);
    color: white;
    border: none;
    padding: 8px 20px;
    border-radius: 50px;
    font-weight: 500;
    font-size: 14px;
    transition: all 0.3s ease;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .clear-btn:hover {
    background: #e55a5a;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(255,107,107,0.3);
  }
  .wishlist-count {
    color: #6c757d;
    font-size: 15px;
  }
  .wishlist-count strong {
    color: var(--dark);
  }

  .wishlist-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 25px;
    width: 100%;
    align-content: start;
  }

  .wishlist-card {
    background: white;
    border-radius: var(--border-radius);
    overflow: hidden;
    transition: all 0.3s ease;
    box-shadow: var(--shadow);
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .wishlist-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.12);
  }
  .wishlist-card .product-image-container {
    position: relative;
    padding-top: 100%;
    overflow: hidden;
    background: #f5f5f5;
    flex-shrink: 0;
  }
  .wishlist-card img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .wishlist-card:hover img {
    transform: scale(1.05);
  }
  .wishlist-card .product-info {
    padding: 16px 18px 18px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .wishlist-card h4 {
    font-size: 18px;
    font-weight: 500;
    margin-bottom: 6px !important;
    color: var(--dark);
    font-family: 'Rokkitt', var(--font-main);
    line-height: 1.3;
  }
  .wishlist-card .product-price {
    display: flex;
    align-items: center;
    margin-bottom: 10px;
  }
  .wishlist-card .sale-price {
    font-size: 17px;
    font-weight: 600;
    color: var(--primary-dark);
  }
  .wishlist-card .regular-price {
    font-size: 13px;
    color: #adb5bd;
    text-decoration: line-through;
    margin-left: 8px;
  }

  .wishlist-options {
    display: flex;
    gap: 8px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  .wishlist-options .size-select {
    flex: 2;
    min-width: 80px;
    padding: 6px 8px;
    border: 1px solid var(--gray);
    border-radius: 6px;
    font-size: 13px;
    background: white;
  }
  .wishlist-options .qty-control {
    display: flex;
    align-items: center;
    border: 1px solid var(--gray);
    border-radius: 6px;
    overflow: hidden;
    background: white;
  }
  .wishlist-options .qty-control button {
    background: transparent;
    border: none;
    width: 30px;
    height: 32px;
    cursor: pointer;
    font-size: 16px;
    color: #6c757d;
    transition: background 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .wishlist-options .qty-control button:hover {
    background: var(--light);
  }
  .wishlist-options .qty-control input {
    width: 36px;
    text-align: center;
    border: none;
    background: transparent;
    font-size: 14px;
    font-weight: 500;
    padding: 4px 0;
  }
  .wishlist-options .qty-control input::-webkit-outer-spin-button,
  .wishlist-options .qty-control input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .wishlist-options .qty-control input[type="number"] {
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .wishlist-actions-buttons {
    display: flex;
    gap: 8px;
    margin-top: auto;
  }
  .btn-move-cart {
    flex: 1;
    background: var(--primary);
    color: white;
    border: none;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.3s;
    text-align: center;
    text-decoration: none;
  }
  .btn-move-cart:hover {
    background: var(--primary-dark);
  }
  .btn-remove {
    background: transparent;
    color: #dc3545;
    border: 1.5px solid #dc3545;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .btn-remove:hover {
    background: #dc3545;
    color: white;
  }

  .empty-wishlist {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 20px;
    background: white;
    border-radius: var(--border-radius);
    box-shadow: var(--shadow);
  }
  .empty-wishlist i {
    font-size: 60px;
    color: #ddd;
    margin-bottom: 20px;
  }
  .empty-wishlist h3 {
    font-family: 'Rokkitt', Georgia, serif;
    font-size: 28px;
    color: var(--dark);
    margin-bottom: 10px;
  }
  .empty-wishlist p {
    color: #6c757d;
    font-size: 16px;
    max-width: 400px;
    margin: 0 auto 20px;
  }
  .empty-wishlist .shop-link {
    display: inline-block;
    background: var(--primary);
    color: white;
    padding: 10px 30px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 500;
    transition: background 0.3s;
  }
  .empty-wishlist .shop-link:hover {
    background: var(--primary-dark);
  }

  @media (max-width: 768px) {
    .wishlist-actions { flex-direction: column; align-items: stretch; }
    .clear-btn { text-align: center; justify-content: center; }
    .wishlist-grid { grid-template-columns: repeat(auto-fill, minmax(200px,1fr)); }
  }
  @media (max-width: 576px) {
    .wishlist-grid { grid-template-columns: repeat(auto-fill, minmax(160px,1fr)); gap: 15px; }
    .wishlist-card h4 { font-size: 15px; }
    .sale-price { font-size: 15px; }
    .wishlist-options .size-select { min-width: 60px; font-size: 12px; }
  }
</style>

<div class="main-container">
  <section class="wishlist-page">
    <div class="wishlist-header">
      <h2><i class="fas fa-heart" style="color:var(--accent);"></i> My Wishlist</h2>
      <p>Your saved items – ready when you are</p>
    </div>

    <div class="wishlist-actions">
      <div class="wishlist-count">
        <strong><%= wishlist ? wishlist.products.length : 0 %></strong> items in your wishlist
      </div>
      <% if (wishlist && wishlist.products.length > 0) { %>
        <form action="/wishlist/clear" method="POST">
          <button type="submit" class="btn-remove">
            <i class="fas fa-trash-alt"></i> Clear Wishlist
          </button>
        </form>
      <% } %>
    </div>

    <div class="wishlist-grid">
      <% if (wishlist && wishlist.products.length > 0) { %>
        <% wishlist.products.forEach(item => { %>
          <div class="wishlist-card" data-product-id="<%= item.productId._id %>">
            <a href="/products/<%= item.productId._id %>">
              <div class="product-image-container">
                <img src="<%= item.productId.images && item.productId.images[0] || '/images/default.jpg' %>" alt="<%= item.productId.productName %>">
              </div>
            </a>
            <div class="product-info">
              <h4><%= item.productId.productName %></h4>
              <div class="product-price">
                <span class="sale-price">₹<%= item.productId.price.toLocaleString('en-IN') %></span>
                <!-- <% if (item.productId.regularPrice) { %>
                  <span class="regular-price">₹<%= item.productId.regularPrice.toLocaleString('en-IN') %></span>
                <% } %> -->
              </div>

              <!-- Size + Quantity -->
              <div class="wishlist-options">
                <select class="size-select" name="size" required>
                  <option value="">Select Size</option>
                  <% if (item.productId.sizes && item.productId.sizes.length) { %>
                    <% item.productId.sizes.forEach(size => { %>
                      <option value="<%= size %>">
                        <%= size %>
                      </option>
                    <% }); %>
                  <% } else { %>
                    <option value="default">Standard</option>
                  <% } %>
                </select>
                <div class="qty-control">
                  <button type="button" class="qty-minus">−</button>
                  <input type="number" class="qty-input" value="1" min="1" max="5" />
                  <button type="button" class="qty-plus">+</button>
                </div>
              </div>

              <div class="wishlist-actions-buttons">
                <form action="/wishlist/add-to-cart" method="POST" style="flex:1; display:contents;">
                  <input type="hidden" name="productId" value="<%= item.productId._id %>">
                  <input type="hidden" name="size" class="selected-size" value="" required>
                  <input type="hidden" name="quantity" class="selected-qty" value="1">
                  <button type="submit" class="btn-move-cart"><i class="fas fa-shopping-cart"></i> Move to Cart</button>
                </form>
                <form action="/wishlist/remove/<%= item.productId._id %>" method="POST" style="display:inline-block; margin-top: 6px;">
                  <button type="submit" class="btn-remove">
                    <i class="fas fa-trash"></i>
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="empty-wishlist">
          <i class="fas fa-heart-broken"></i>
          <h3>Your wishlist is empty</h3>
          <p>Start adding your favourite items – they’ll be saved here for later.</p>
          <a href="/shop" class="shop-link">Start Shopping</a>
        </div>
      <% } %>
    </div>
  </section>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/waypoints/4.0.1/jquery.waypoints.min.js"></script>
	<script src="/js/jquery.flexslider-min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // ---- Quantity controls ----
    document.querySelectorAll('.qty-control').forEach(function(control) {
      const minusBtn = control.querySelector('.qty-minus');
      const plusBtn = control.querySelector('.qty-plus');
      const input = control.querySelector('.qty-input');
      const max = parseInt(input.max);

      minusBtn.addEventListener('click', function() {
        let val = parseInt(input.value);
        if (val > 1) {
          input.value = val - 1;
        }
      });

      plusBtn.addEventListener('click', function() {
        let val = parseInt(input.value);
        if (val < max) {
          input.value = val + 1;
        } else {
          // alert('Maximum quantity is ' + max);
        }
      });
    });
  });

  
document.querySelectorAll('.wishlist-card').forEach(card => {

    const sizeSelect = card.querySelector('.size-select');
    const selectedSize = card.querySelector('.selected-size');

    const qtyInput = card.querySelector('.qty-input');
    const selectedQty = card.querySelector('.selected-qty');
    const form = card.querySelector('form[action="/wishlist/add-to-cart"]');


    sizeSelect.addEventListener('change', function () {
      selectedSize.value = this.value;
    });

    form.addEventListener('submit', async function (e) {
      e.preventDefault();

      const size = sizeSelect.value;

      //frontend validation
      if (!size) {
        Swal.fire({
          icon:'Warning',
          title: 'Select a size',
          text: 'Please select a size before moving this product to your cart',
          confirmButtonColor: '#88c8bc'
        });
        return;
      }

      selectedSize.value = size;
      selectedQty.value = qtyInput.value;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded'
          },
          body: new URLSearchParams(new FormData(form))
        });

        const data = await response.json();

        if (!response.ok) {
          Swal.fire({
            icon: 'warning', title: 'Unable to move to cart', text: data.message || 'Something went wrong.', confirmButtonColor: '#88c8bc'
          });
          return;
        }

        Swal.fire({
          icon: 'success', 
          title: 'Added to cart', 
          text: data.message, 
          confirmButtonColor: '#88c8bc'
        }).then(() => {
          window.location.reload();
        });


      } catch (error) {
        console.error('Move to Cart Error:', err);

        Swal.fire({
          icon: 'error', 
          title: 'Something went wrong', 
          text: 'Please try again later.', 
          confirmButtonColor: '#88c8bc'
        });
      }
    });

    card.querySelector('.qty-minus').addEventListener('click', function () {
      let value = parseInt(qtyInput.value);

      if (value > 1) {
        value--;
        qtyInput.value = value;
        selectedQty.value = value;
      }
    });

    card.querySelector('.qty-plus').addEventListener('click', function () {
      let value = parseInt(qtyInput.value);
      const max = parseInt(qtyInput.max);

      if (value < max) {
        value++;
        qtyInput.value = value;
        selectedQty.value = value;
      }
    });

});

</script>

<%- include('../partials/account/footer') %>