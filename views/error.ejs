<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page Not Found | SOLESYNTAX</title>
    <link href="https://fonts.googleapis.com/css?family=Montserrat:300,400,500,600,700" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Rokkitt:100,300,400,700" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <link rel="icon" type="image/png" href="/images/Logo.png">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: "Montserrat", "Poppins",  sans-serif;
            background: #f8f9fa;
            height: 100vh;
            display: grid;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 20px;
        }
        .error-container {
            max-width: 600px;
            padding: 40px 30px;
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.08);
            transition: 0.3s;
        }
        .error-icon {
            font-size: 80px;
            color: #88c8bc;
            margin-bottom: 20px;
            display: block;
        }
        h1 {
            font-family: "Rokkitt", Georgia, serif;
            font-size: 72px;
            font-weight: 700;
            color: #333;
            margin-bottom: 10px;
            line-height: 1;
        }
        h2 {
            font-size: 28px;
            font-weight: 600;
            color: #333;
            margin-bottom: 15px;
        }
        p {
            color: #6c757d;
            font-size: 16px;
            line-height: 1.6;
            margin-bottom: 25px;
        }
        a {
            text-decoration: none;
        }
        .btn-home {
            display: inline-block;
            background: #88c8bc;
            color: #fff;
            padding: 12px 35px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 500;
            font-size: 16px;
            transition: background 0.3s, transform 0.2s;
            box-shadow: 0 4px 12px rgba(136,200,188,0.3);
        }
        .btn-home:hover {
            background: #66a59b;
            transform: translateY(-2px);
        }
        .btn-home i {
            margin-right: 8px;
        }
        .error-details {
            margin-top: 20px;
            font-size: 14px;
            color: #adb5bd;
        }
        @media (max-width: 576px) {
            h1 { font-size: 56px; }
            h2 { font-size: 22px; }
            .error-container { padding: 30px 20px; }
        }
    </style>
</head>
<body>
    <!-- <div class="error-container">
        <span class="error-icon"><i class="fas fa-map-signs"></i></span>
        <h1>404</h1>
        <h2>Page Not Found</h2>
        <p>Oops! The page you're looking for doesn't exist or has been moved. Let's get you back on track.</p>
        <a href="/" class="btn-home"><i class="fas fa-home"></i> Go Home</a>
        <div class="error-details"><span style="color: #cb6262;">Error Code: 404</span> | <span style="color: #66a59b;">SOLESYNTAX</span></div>
    </div> -->
    

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="error-container p-5 bg-white rounded shadow-sm">
                <div class="display-1 text-primary" style="color:#88c8bc !important; font-size:80px;">
                    <% if (status === 404) { %>
                        <i class="fas fa-map-signs"></i>
                    <% } else if (status === 500) { %>
                        <i class="fas fa-exclamation-triangle"></i>
                    <% } else if (status === 403) { %>
                        <i class="fas fa-lock"></i>
                    <% } else { %>
                        <i class="fas fa-exclamation-circle"></i>
                    <% } %>
                </div>
                <h1 class="display-1 fw-bold" style="font-family:'Rokkitt',serif; font-size:96px; color:#333;"><%= status || 500 %></h1>
                <h2 class="h3 mb-3"><%= title || 'Something Went Wrong' %></h2>
                <p class="text-muted mb-4"><%= message || 'We\'re sorry, but an unexpected error occurred. Please try again later.' %></p>
                <a href="/" class="btn-home"><i class="fas fa-home"></i> Go Home</a>
                <div class="mt-4 text-muted small error-details"><span style="color: #cb6262;">Error Code: <%= status || 500 %></span> | <a href="/"><span style="color: #66a59b;">SOLESYNTAX</span></a></div>
            </div>
        </div>
    </div>
</div>
<%- include('partials/account/footer') %>
</body>
</html>