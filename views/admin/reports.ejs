<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Reports</h2>
        <p class="text-muted mb-0">
            Overview of your store's sales and performance
        </p>
    </div>


    <!-- Main Statistics -->

    <div class="row g-4 mb-4">

        <!-- Revenue -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Total Revenue</p>

                    <h3 class="fw-bold mb-0">
                        ₹<%= totalRevenue.toLocaleString('en-IN') %>
                    </h3>

                    <small class="text-muted">
                        From delivered orders
                    </small>
                </div>
            </div>
        </div>


        <!-- Orders -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Total Orders</p>

                    <h3 class="fw-bold mb-0">
                        <%= totalOrders %>
                    </h3>

                    <small class="text-muted">
                        All orders
                    </small>
                </div>
            </div>
        </div>


        <!-- Customers -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Customers</p>

                    <h3 class="fw-bold mb-0">
                        <%= totalCustomers %>
                    </h3>

                    <small class="text-muted">
                        Registered customers
                    </small>
                </div>
            </div>
        </div>


        <!-- Products -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Products</p>

                    <h3 class="fw-bold mb-0">
                        <%= totalProducts %>
                    </h3>

                    <small class="text-muted">
                        Products in store
                    </small>
                </div>
            </div>
        </div>

    </div>


    <!-- Order Statistics -->

    <div class="row g-4 mb-4">

        <!-- Delivered -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">

                    <p class="text-muted mb-2">
                        Delivered Orders
                    </p>

                    <h3 class="fw-bold text-success">
                        <%= deliveredOrders %>
                    </h3>

                </div>
            </div>
        </div>


        <!-- Cancelled -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">

                    <p class="text-muted mb-2">
                        Cancelled Orders
                    </p>

                    <h3 class="fw-bold text-danger">
                        <%= cancelledOrders %>
                    </h3>

                </div>
            </div>
        </div>


        <!-- Returned -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">

                    <p class="text-muted mb-2">
                        Returned Orders
                    </p>

                    <h3 class="fw-bold text-warning">
                        <%= returnedOrders %>
                    </h3>

                </div>
            </div>
        </div>

    </div>


    <!-- Discount -->

    <div class="row">

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm">
                <div class="card-body">

                    <p class="text-muted mb-2">
                        Total Discounts Given
                    </p>

                    <h3 class="fw-bold">
                        ₹<%= totalDiscount.toLocaleString('en-IN') %>
                    </h3>

                    <small class="text-muted">
                        Discounts applied to delivered orders
                    </small>

                </div>
            </div>

        </div>

    </div>

</div>

<div class="card mt-4">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
        <h5 class="card-title mb-0">Sales Revenue</h5>

        <select id="salesRange" class="form-select" style="width: 180px;">
            <option value="7days">Last 7 Days</option>
            <option value="30days" selected>Last 30 Days</option>
            <option value="6months">Last 6 Months</option>
        </select>
    </div>
    <div style="position: relative; height: 350px;">
      <canvas id="salesChart"></canvas>
    </div>
  </div>
</div>

<script src="/vendor/chart.js/chart.umd.js"></script>


<script>
  let salesChartInstance = null;

  async function loadSalesChart() {
    try {
      const range = document.getElementById('salesRange').value;

      const response = await fetch(
        `/admin/reports/sales?range=${range}`
      );

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(
          result.message || 'Failed to load sales data'
        );
      }

      // Map each returned date to its revenue and order count.
      const revenueByDate = new Map();
      const ordersByDate = new Map();

      result.salesData.forEach(item => {
        const year = item._id.year;
        const month = String(item._id.month).padStart(2, '0');
        const day = String(item._id.day).padStart(2, '0');
        const dateKey = `${year}-${month}-${day}`;

        revenueByDate.set(dateKey, item.revenue);
        ordersByDate.set(dateKey, item.orders);
      });

      const labels = [];
      const revenueValues = [];
      const orderValues = [];

      // Build one point per day for the 7-day and 30-day ranges.
      if (range === '7days' || range === '30days') {
        const totalDays = range === '7days' ? 7 : 30;
        const startDate = new Date(result.startDate);

        for (let i = 0; i < totalDays; i++) {
          const date = new Date(startDate);
          date.setDate(startDate.getDate() + i);

          const year = date.getFullYear();
          const month = String(date.getMonth() + 1).padStart(2, '0');
          const day = String(date.getDate()).padStart(2, '0');
          const dateKey = `${year}-${month}-${day}`;

          labels.push(`${day}/${month}`);
          revenueValues.push(revenueByDate.get(dateKey) || 0);
          orderValues.push(ordersByDate.get(dateKey) || 0);
        }
      } else {
        // For six months, group daily data by calendar month.
        const monthlyRevenue = new Map();
        const monthlyOrders = new Map();
        const startDate = new Date(result.startDate);
        const endDate = new Date(result.endDate);

        const currentMonth = new Date(
          startDate.getFullYear(),
          startDate.getMonth(),
          1
        );

        const lastMonth = new Date(
          endDate.getFullYear(),
          endDate.getMonth(),
          1
        );

        while (currentMonth <= lastMonth) {
          const key =
            `${currentMonth.getFullYear()}-` +
            `${String(currentMonth.getMonth() + 1).padStart(2, '0')}`;

          monthlyRevenue.set(key, 0);
          monthlyOrders.set(key, 0);

          currentMonth.setMonth(currentMonth.getMonth() + 1);
        }

        result.salesData.forEach(item => {
          const key =
            `${item._id.year}-` +
            `${String(item._id.month).padStart(2, '0')}`;

          monthlyRevenue.set(
            key,
            (monthlyRevenue.get(key) || 0) + item.revenue
          );

          monthlyOrders.set(
            key,
            (monthlyOrders.get(key) || 0) + item.orders
          );
        });

        for (const [key, revenue] of monthlyRevenue) {
          const [year, month] = key.split('-');

          labels.push(
            new Date(Number(year), Number(month) - 1, 1)
              .toLocaleDateString('en-IN', {
                month: 'short',
                year: 'numeric'
              })
          );

          revenueValues.push(revenue);
          orderValues.push(monthlyOrders.get(key) || 0);
        }
      }

      const canvas = document.getElementById('salesChart');

      // Update the existing chart instead of creating duplicates.
      if (salesChartInstance) {
        salesChartInstance.destroy();
      }

      salesChartInstance = new Chart(canvas, {
        type: 'line',
        data: {
          labels,
          datasets: [{
            label: 'Daily Revenue (₹)',
            data: revenueValues,
            borderColor: '#2563eb',
            backgroundColor: 'rgba(37, 99, 235, 0.12)',
            borderWidth: 2,
            fill: true,
            tension: 0.3,
            pointRadius: range === '6months' ? 4 : 3
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: {
              beginAtZero: true,
              title: {
                display: true,
                text: 'Revenue (₹)'
              },
              ticks: {
                callback: value =>
                  '₹' + Number(value).toLocaleString('en-IN')
              }
            },
            x: {
              title: {
                display: true,
                text: range === '6months' ? 'Month' : 'Date'
              }
            }
          },
          plugins: {
            tooltip: {
              callbacks: {
                label: function(context) {
                  const revenue = context.parsed.y;
                  const orders = orderValues[context.dataIndex];

                  return [
                    'Revenue: ₹' +
                      revenue.toLocaleString('en-IN'),
                    'Delivered orders: ' + orders
                  ];
                }
              }
            }
          }
        }
      });
    } catch (error) {
      console.error('Sales chart error:', error);
    }
  }

  document.getElementById('salesRange').addEventListener(
    'change',
    loadSalesChart
  );

  loadSalesChart();
</script>