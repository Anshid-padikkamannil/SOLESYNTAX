<div class="container-fluid reports-page">

    <!-- Page Header -->
    <div class="reports-header">
        <div>
            <span class="reports-eyebrow">STORE ANALYTICS</span>
            <h2>Reports</h2>
            <p>Overview of your store's sales and performance</p>
        </div>

        <div class="reports-header-icon">
            <i class="fas fa-chart-line"></i>
        </div>
    </div>

    <!-- Main Statistics: Grid Layout (4 columns) -->
    <div class="reports-stat-list">

        <!-- Revenue (Mint Theme) -->
        <div class="report-stat-card card-mint">
            <div class="report-icon">
                <i class="fas fa-wallet"></i>
            </div>
            <p class="report-stat-title">Total Revenue</p>
            <h3>₹<%= totalRevenue.toLocaleString('en-IN') %></h3>
            <p class="report-stat-description">
                From delivered orders
            </p>
        </div>

        <!-- Orders (Light Green Theme) -->
        <div class="report-stat-card card-green">
            <div class="report-icon">
                <i class="fas fa-shopping-bag"></i>
            </div>
            <p class="report-stat-title">Total Orders</p>
            <h3><%= totalOrders %></h3>
            <p class="report-stat-description">
                All orders
            </p>
        </div>

        <!-- Customers (Purple Theme) -->
        <div class="report-stat-card card-purple">
            <div class="report-icon">
                <i class="fas fa-users"></i>
            </div>
            <p class="report-stat-title">Total Customers</p>
            <h3><%= totalCustomers %></h3>
            <p class="report-stat-description">
                Registered customers
            </p>
        </div>

        <!-- Products (Orange Theme) -->
        <div class="report-stat-card card-orange">
            <div class="report-icon">
                <i class="fas fa-box-open"></i>
            </div>
            <p class="report-stat-title">Total Products</p>
            <h3><%= totalProducts %></h3>
            <p class="report-stat-description">
                Products in store
            </p>
        </div>

    </div>

    <!-- Order Overview -->
    <div class="reports-section-heading">
        <h4>Order Overview</h4>
        <p>A breakdown of your order outcomes</p>
    </div>

    <!-- Order Statistics: Grid Layout (3 columns) -->
    <div class="reports-order-list">

        <div class="order-stat-card">
            <div class="order-stat-icon delivered-icon">
                <i class="fas fa-check"></i>
            </div>
            <div>
                <p>Delivered Orders</p>
                <h3><%= deliveredOrders %></h3>
            </div>
            <span class="order-stat-indicator delivered-indicator"></span>
        </div>

        <div class="order-stat-card">
            <div class="order-stat-icon cancelled-icon">
                <i class="fas fa-times"></i>
            </div>
            <div>
                <p>Cancelled Orders</p>
                <h3><%= cancelledOrders %></h3>
            </div>
            <span class="order-stat-indicator cancelled-indicator"></span>
        </div>

        <div class="order-stat-card">
            <div class="order-stat-icon returned-icon">
                <i class="fas fa-undo-alt"></i>
            </div>
            <div>
                <p>Returned Orders</p>
                <h3><%= returnedOrders %></h3>
            </div>
            <span class="order-stat-indicator returned-indicator"></span>
        </div>

    </div>

    <!-- Discounts -->
    <div class="reports-section-heading">
        <h4>Discount Summary</h4>
        <p>Total promotional discounts applied</p>
    </div>

    <div class="discount-card">
        <div class="discount-icon">
            <i class="fas fa-tags"></i>
        </div>
        <div class="discount-content">
            <p>Total Discounts Given</p>
            <h3>₹<%= totalDiscount.toLocaleString('en-IN') %></h3>
            <span>Discounts applied to delivered orders</span>
        </div>
    </div>

    <!-- Sales Revenue Chart -->
    <div class="sales-chart-card">
        <div class="sales-chart-header">
            <div>
                <span class="chart-eyebrow">PERFORMANCE</span>
                <h4>Sales Revenue</h4>
                <p>Track revenue and delivered orders over time</p>
            </div>

            <div class="chart-range-control">
                <label for="salesRange">Time period</label>
                <select id="salesRange" class="form-select">
                    <option value="7days">Last 7 Days</option>
                    <option value="30days" selected>Last 30 Days</option>
                    <option value="6months">Last 6 Months</option>
                </select>
            </div>
        </div>

        <div class="sales-chart-legend">
            <span class="legend-dot"></span>
            <span>Revenue</span>
            <span class="legend-unit">INR (₹)</span>
        </div>

        <div class="sales-chart-wrapper">
            <canvas id="salesChart"></canvas>
        </div>
    </div>

</div>

<style>
/* ========================================
   SOLESYNTAX REPORTS
======================================== */

.reports-page {
    padding-bottom: 35px;
    color: var(--text, #333333);
}

/* Header */
.reports-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
}

.reports-eyebrow,
.chart-eyebrow {
    display: inline-block;
    color: var(--primary-dark, #66a59b);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.6px;
    margin-bottom: 8px;
}

.reports-header h2 {
    color: var(--dark, #1a1a2e);
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 7px;
}

.reports-header p,
.reports-section-heading p,
.sales-chart-header p {
    color: var(--text-muted, #6c757d);
    font-size: 13px;
    margin-bottom: 0;
}

.reports-header-icon {
    width: 54px;
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: var(--primary-light, #f0f9f7);
    color: var(--primary-dark, #66a59b);
    border-radius: 14px;
    font-size: 21px;
}

/* ========================================
   TOP METRIC CARDS (Pastel Themes)
======================================== */
.reports-stat-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.report-stat-card {
    width: 100%;
    padding: 24px;
    border-radius: 16px;
    transition: transform .2s ease, box-shadow .2s ease;
}

.report-stat-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0,0,0,.04);
}

/* Card Themes */
.card-mint {
    background: #effbf6;
    border: 1px solid #e0f2eb;
}
.card-green {
    background: #f3fcf6;
    border: 1px solid #e3f5e8;
}
.card-purple {
    background: #f5f4ff;
    border: 1px solid #e9e7fd;
}
.card-orange {
    background: #fffbf3;
    border: 1px solid #fdf0dc;
}

/* Icon Styling (White square with shadow) */
.report-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    font-size: 20px;
    background: #ffffff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    margin-bottom: 20px;
}

/* Icon Colors */
.card-mint .report-icon i { color: #10b981; } /* Green */
.card-green .report-icon i { color: #22c55e; } /* Light Green */
.card-purple .report-icon i { color: #8b5cf6; } /* Purple */
.card-orange .report-icon i { color: #f59e0b; } /* Orange */

.report-stat-title {
    color: #334155;
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 8px;
}

.report-stat-card h3 {
    color: #0f172a;
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 14px;
    overflow-wrap: anywhere;
}

.report-stat-description {
    color: #64748b;
    font-size: 12px;
    margin-bottom: 0;
}


/* ========================================
   ORDER OVERVIEW CARDS
======================================== */
.reports-section-heading {
    margin: 35px 0 16px;
}

.reports-section-heading h4 {
    color: var(--dark, #1a1a2e);
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 6px;
}

.reports-order-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.order-stat-card {
    width: 100%;
    min-height: 105px;
    display: flex;
    align-items: center;
    gap: 16px;
    position: relative;
    padding: 22px 24px;
    background: #ffffff;
    border: 1px solid #edf0f2;
    border-radius: var(--radius, 12px);
    box-shadow: var(--shadow-sm, 0 2px 10px rgba(0,0,0,.05));
    transition: transform .2s ease, box-shadow .2s ease;
}

.order-stat-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow, 0 8px 40px rgba(0,0,0,.08));
}

.order-stat-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 12px;
    font-size: 18px;
}

.delivered-icon {
    color: #258663;
    background: #e7f6ef;
}

.cancelled-icon {
    color: #c7505b;
    background: #fcebed;
}

.returned-icon {
    color: #a97922;
    background: #fff4df;
}

.order-stat-card p {
    color: var(--text-muted, #6c757d);
    font-size: 13px;
    margin-bottom: 8px;
}

.order-stat-card h3 {
    color: var(--dark, #1a1a2e);
    font-size: 26px;
    font-weight: 700;
    margin-bottom: 0;
}

.order-stat-indicator {
    width: 5px;
    position: absolute;
    top: 18px;
    bottom: 18px;
    right: 0;
    border-radius: 5px 0 0 5px;
}

.delivered-indicator { background: #55b895; }
.cancelled-indicator { background: #e27a83; }
.returned-indicator { background: #e8bd63; }

/* ========================================
   DISCOUNT CARD
======================================== */
.discount-card {
    display: flex;
    align-items: center;
    gap: 20px;
    width: 100%;
    padding: 24px;
    background: linear-gradient(120deg, #f0f9f7, #ffffff);
    border: 1px solid #dceee8;
    border-radius: var(--radius, 12px);
    box-shadow: var(--shadow-sm, 0 2px 10px rgba(0,0,0,.05));
}

.discount-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: #d9f0e8;
    color: #398d76;
    border-radius: 14px;
    font-size: 20px;
}

.discount-content p {
    color: var(--text-muted, #6c757d);
    font-size: 14px;
    margin-bottom: 8px;
}

.discount-content h3 {
    color: var(--dark, #1a1a2e);
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 8px;
    overflow-wrap: anywhere;
}

.discount-content span {
    color: #8b949f;
    font-size: 12px;
}

/* ========================================
   SALES CHART
======================================== */
.sales-chart-card {
    width: 100%;
    margin-top: 28px;
    padding: 25px;
    background: #ffffff;
    border: 1px solid #edf0f2;
    border-radius: var(--radius-lg, 16px);
    box-shadow: var(--shadow-sm, 0 2px 10px rgba(0,0,0,.05));
}

.sales-chart-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    flex-wrap: wrap;
    padding-bottom: 22px;
    border-bottom: 1px solid #f0f2f4;
}

.sales-chart-header h4 {
    color: var(--dark, #1a1a2e);
    font-size: 19px;
    font-weight: 700;
    margin-bottom: 7px;
}

.chart-range-control {
    width: 180px;
}

.chart-range-control label {
    display: block;
    color: #7d8792;
    font-size: 11px;
    font-weight: 600;
    margin-bottom: 7px;
}

.chart-range-control .form-select {
    min-height: 42px;
    border: 1px solid #dfe7e5;
    border-radius: 9px;
    color: #40514f;
    font-size: 12px;
    box-shadow: none;
    cursor: pointer;
}

.chart-range-control .form-select:focus {
    border-color: var(--primary-dark, #66a59b);
    box-shadow: 0 0 0 3px rgba(102,165,155,.15);
}

.sales-chart-legend {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 20px 0 5px;
    color: #69737e;
    font-size: 12px;
}

.legend-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--primary-dark, #66a59b);
}

.legend-unit {
    margin-left: 3px;
    color: #a0a7af;
    font-size: 10px;
}

.sales-chart-wrapper {
    position: relative;
    width: 100%;
    height: 340px;
    margin-top: 10px;
}

/* ========================================
   RESPONSIVE
======================================== */
@media (max-width: 1024px) {
    .reports-stat-list {
        grid-template-columns: repeat(2, 1fr);
    }
    .reports-order-list {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 767px) {
    .reports-header h2 {
        font-size: 24px;
    }

    .reports-stat-list,
    .reports-order-list {
        grid-template-columns: 1fr;
    }

    .report-stat-card,
    .order-stat-card {
        padding: 18px;
    }

    .discount-card,
    .sales-chart-card {
        padding: 18px;
    }

    .sales-chart-header {
        align-items: stretch;
    }

    .chart-range-control {
        width: 100%;
    }

    .sales-chart-wrapper {
        height: 280px;
    }
}
</style>

<script src="/vendor/chart.js/chart.umd.js"></script>

<script>
let salesChartInstance = null;

async function loadSalesChart() {
    try {
        const range = document.getElementById('salesRange').value;

        const response = await fetch(
            `/admin/reports/sales?range=${range}`
        );

        const result = await response.json();

        if (!response.ok || !result.success) {
            throw new Error(
                result.message || 'Failed to load sales data'
            );
        }

        const revenueByDate = new Map();
        const ordersByDate = new Map();

        result.salesData.forEach(item => {
            const year = item._id.year;
            const month = String(item._id.month).padStart(2, '0');
            const day = String(item._id.day).padStart(2, '0');
            const dateKey = `${year}-${month}-${day}`;

            revenueByDate.set(dateKey, item.revenue);
            ordersByDate.set(dateKey, item.orders);
        });

        const labels = [];
        const revenueValues = [];
        const orderValues = [];

        if (range === '7days' || range === '30days') {
            const totalDays = range === '7days' ? 7 : 30;
            const startDate = new Date(result.startDate);

            for (let i = 0; i < totalDays; i++) {
                const date = new Date(startDate);
                date.setDate(startDate.getDate() + i);

                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const day = String(date.getDate()).padStart(2, '0');
                const dateKey = `${year}-${month}-${day}`;

                labels.push(`${day}/${month}`);
                revenueValues.push(revenueByDate.get(dateKey) || 0);
                orderValues.push(ordersByDate.get(dateKey) || 0);
            }
        } else {
            const monthlyRevenue = new Map();
            const monthlyOrders = new Map();

            const startDate = new Date(result.startDate);
            const endDate = new Date(result.endDate);

            const currentMonth = new Date(
                startDate.getFullYear(),
                startDate.getMonth(),
                1
            );

            const lastMonth = new Date(
                endDate.getFullYear(),
                endDate.getMonth(),
                1
            );

            while (currentMonth <= lastMonth) {
                const key =
                    `${currentMonth.getFullYear()}-` +
                    `${String(currentMonth.getMonth() + 1).padStart(2, '0')}`;

                monthlyRevenue.set(key, 0);
                monthlyOrders.set(key, 0);

                currentMonth.setMonth(currentMonth.getMonth() + 1);
            }

            result.salesData.forEach(item => {
                const key =
                    `${item._id.year}-` +
                    `${String(item._id.month).padStart(2, '0')}`;

                monthlyRevenue.set(
                    key,
                    (monthlyRevenue.get(key) || 0) + item.revenue
                );

                monthlyOrders.set(
                    key,
                    (monthlyOrders.get(key) || 0) + item.orders
                );
            });

            for (const [key, revenue] of monthlyRevenue) {
                const [year, month] = key.split('-');

                labels.push(
                    new Date(Number(year), Number(month) - 1, 1)
                        .toLocaleDateString('en-IN', {
                            month: 'short',
                            year: 'numeric'
                        })
                );

                revenueValues.push(revenue);
                orderValues.push(monthlyOrders.get(key) || 0);
            }
        }

        if (salesChartInstance) {
            salesChartInstance.destroy();
        }

        salesChartInstance = new Chart(
            document.getElementById('salesChart'),
            {
                type: 'line',
                data: {
                    labels,
                    datasets: [{
                        label: 'Revenue (₹)',
                        data: revenueValues,
                        borderColor: '#66a59b',
                        backgroundColor: 'rgba(102,165,155,0.13)',
                        borderWidth: 2.5,
                        fill: true,
                        tension: 0.3,
                        pointRadius: range === '6months' ? 4 : 3,
                        pointBackgroundColor: '#66a59b',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        intersect: false,
                        mode: 'index'
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: '#f0f2f4',
                                drawBorder: false
                            },
                            title: {
                                display: true,
                                text: 'Revenue (₹)',
                                color: '#7d8792'
                            },
                            ticks: {
                                color: '#7d8792',
                                callback: value =>
                                    '₹' + Number(value).toLocaleString('en-IN')
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            },
                            title: {
                                display: true,
                                text: range === '6months' ? 'Month' : 'Date',
                                color: '#7d8792'
                            },
                            ticks: {
                                color: '#7d8792',
                                maxTicksLimit: range === '30days' ? 10 : undefined
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: '#24243e',
                            padding: 12,
                            cornerRadius: 8,
                            callbacks: {
                                label: function(context) {
                                    const revenue = context.parsed.y;
                                    const orders = orderValues[context.dataIndex];

                                    return [
                                        'Revenue: ₹' +
                                            revenue.toLocaleString('en-IN'),
                                        'Delivered orders: ' + orders
                                    ];
                                }
                            }
                        }
                    }
                }
            }
        );
    } catch (error) {
        console.error('Sales chart error:', error);
    }
}

document.getElementById('salesRange').addEventListener(
    'change',
    loadSalesChart
);

loadSalesChart();
</script>