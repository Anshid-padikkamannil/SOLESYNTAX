<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | SOLESYNTAX Admin</title>

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Rokkitt:wght@100;300;400;700&display=swap" rel="stylesheet">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">

  <!-- Admin CSS -->
  <link rel="stylesheet" href="/css/admin.css">
</head>

<body>

<div class="admin-wrapper">

  <!-- ===== SIDEBAR ===== -->
  <aside class="admin-sidebar" id="adminSidebar">

    <!-- Logo -->
    <div class="admin-logo">
      <div class="admin-logo-icon">
        <i class="fas fa-shoe-prints"></i>
      </div>
      <div class="admin-logo-text">
        <span class="brand-name">Solesyntax</span>
        <span class="brand-tagline">Step Into Style</span>
      </div>
    </div>

    <!-- Nav -->
    <nav class="admin-nav">
      <a href="/admin" class="<%= currentPage === 'dashboard' ? 'active' : '' %>">
        <i class="fas fa-th-large"></i> Dashboard
      </a>
      <a href="/admin/products" class="<%= currentPage === 'products' ? 'active' : '' %>">
        <i class="fas fa-box"></i> Products
      </a>
      <a href="/admin/orders" class="<%= currentPage === 'orders' ? 'active' : '' %>">
        <i class="fas fa-shopping-cart"></i> Orders
      </a>
      <a href="/admin/customers" class="<%= currentPage === 'customers' ? 'active' : '' %>">
        <i class="fas fa-users"></i> Customers
      </a>
      <a href="/admin/coupons" class="<%= currentPage === 'coupons' ? 'active' : '' %>">
        <i class="fas fa-tag"></i> Coupons
      </a>
      <a href="/admin/reviews" class="<%= currentPage === 'reviews' ? 'active' : '' %>">
        <i class="fas fa-star"></i> Reviews
      </a>
      <a href="/admin/reports" class="<%= currentPage === 'reports' ? 'active' : '' %>">
        <i class="fas fa-chart-line"></i> Reports
      </a>
      <a href="/admin/profile" class="<%= currentPage === 'profile' ? 'active' : '' %>">
        <i class="fas fa-user"></i> Profile
      </a>
    </nav>

    <!-- Sidebar Footer (User Info) -->
    <div class="admin-sidebar-footer">
      <div class="avatar">
          <% let avatarUrl = user?.profilePicture || user?.googleProfilePicture; %>

          <% if (avatarUrl) { %>
            <img
              src="<%= avatarUrl %>"
              alt="Admin profile"
              class="avatar-image"
            >
          <% } else { %>
            <%= user?.name ? user.name.charAt(0).toUpperCase() : 'A' %>
          <% } %>
        </div>
      <div class="info">
        <div class="name"><%= user?.name || 'Admin' %></div>
        <div class="email"><%= user?.email || 'admin@solesyntax.com' %></div>
      </div>
      <a href="/users/logout" class="logout-icon" title="Logout">
        <i class="fas fa-sign-out-alt"></i>
      </a>
    </div>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

  </aside>

  <!-- ===== MAIN CONTAINER ===== -->
  <div class="admin-container">

    <!-- ===== TOPBAR ===== -->
    <header class="admin-topbar">

      <button
        type="button"
        class="sidebar-toggle"
        id="sidebarToggle"
        aria-label="Toggle admin navigation"
        aria-controls="adminSidebar"
        aria-expanded="false"
      >
        <i class="fas fa-bars"></i>
      </button>

      <!-- Notifications -->
      <div class="topbar-notif" title="Notifications">
        <i class="far fa-bell"></i>
        <span class="badge-dot"></span>
      </div>

      <!-- User dropdown -->
      <a href="/admin/profile">
        <div class="topbar-user">
          <div class="avatar">
            <%  avatarUrl = user?.profilePicture || user?.googleProfilePicture; %>

            <% if (avatarUrl) { %>
              <img
                src="<%= avatarUrl %>"
                alt="Admin profile"
                class="avatar-image"
              >
            <% } else { %>
              <%= user?.name ? user.name.charAt(0).toUpperCase() : 'A' %>
            <% } %>
          </div>
          <span class="name"><%= user?.name || 'Admin' %></span>
          <!-- <i class="fas fa-chevron-down chevron"></i> -->
        </div>
      </a>  

    </header>

    <!-- ===== CONTENT ===== -->
    <main class="admin-main">
      <div class="admin-content">
        <%- body %>
      </div>
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="admin-footer">
      <div class="footer-left">
        © <%= new Date().getFullYear() %> Solesyntax. All rights reserved.
      </div>
      <div class="footer-right">
        <span>Admin Panel</span>
        <span class="divider">|</span>
        <span>v1.0.0</span>
      </div>
    </footer>

  </div>

</div>

<script>
  const sidebar = document.getElementById('adminSidebar');
  const sidebarToggle = document.getElementById('sidebarToggle');
  const sidebarOverlay = document.getElementById('sidebarOverlay');

  function openSidebar() {
    sidebar.classList.add('show');
    sidebarOverlay.classList.add('show');
    sidebarToggle.setAttribute('aria-expanded', 'true');
  }

  function closeSidebar() {
    sidebar.classList.remove('show');
    sidebarOverlay.classList.remove('show');
    sidebarToggle.setAttribute('aria-expanded', 'false');
  }

  sidebarToggle?.addEventListener('click', () => {
    sidebar.classList.contains('show')
      ? closeSidebar()
      : openSidebar();
  });

  // Close when clicking the overlay.
  sidebarOverlay?.addEventListener('click', closeSidebar);

  // Close when clicking anywhere outside the sidebar and toggle button.
  document.addEventListener('click', (event) => {
    if (
      window.innerWidth <= 991 &&
      sidebar.classList.contains('show') &&
      !sidebar.contains(event.target) &&
      !sidebarToggle.contains(event.target)
    ) {
      closeSidebar();
    }
  });

  // Close when pressing Escape.
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeSidebar();
  });

  // Reset mobile menu state on desktop.
  window.addEventListener('resize', () => {
    if (window.innerWidth > 991) closeSidebar();
  });
</script>

</body>
</html>