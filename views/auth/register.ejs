<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <title>Sign Up</title>
    <link rel="icon" type="image/png" href="/images/Logo.png">
</head>

<body>

    <div class="page">
        <!-- subtle background decoration -->
        <div class="bg-circle bg-circle-1"></div>
        <div class="bg-circle bg-circle-2"></div>

        <div class="card">
            <!-- brand / logo -->
            <div class="card-brand">
              <!-- <a class="beta" href="/"><img class="logo-md" src="/images/icon.1.1.png" alt="logo"></a> -->
                <!-- <span class="brand-icon">✦</span> -->
                <span class="brand-name"><span class="brand-accent"><a href="/">SOLESYNTAX</a></span></span>
            </div>

            <!-- header -->
            <div class="card-header">
                <h1>Create account</h1>
                <p>Join us — it takes less than a minute.</p>
            </div>

            <!-- ===== GLOBAL ERROR ALERT (hidden by default) ===== -->
            <div id="globalError" class="error-alert" style="display:none;"></div>

            <!-- form -->
            <form class="form" id="registerForm" novalidate>
                <!-- email -->
                <div class="field">
                    <div class="input-wrapper">
                        <input type="email" id="email" placeholder=" " required />
                        <label for="email">Email address</label>
                    </div>
                    <div class="error-message" id="emailError"></div>
                </div>

                <!-- username -->
                <div class="field">
                    <div class="input-wrapper">
                        <input type="text" id="name" placeholder=" " required />
                        <label for="username">Username</label>
                    </div>
                    <div class="error-message" id="nameError"></div>
                </div>

                <!-- password -->
                <div class="field">
                    <div class="input-wrapper">
                        <input type="password" id="password" placeholder=" " required />
                        <label for="password">Password</label>
                        <button type="button" class="toggle-password" aria-label="Toggle password visibility">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                    <div class="error-message" id="passwordError"></div>
                </div>

                <!-- terms -->
                <div class="terms">
                    <label class="checkbox">
                        <input type="checkbox" id="termsCheck" required />
                        <span class="checkmark"></span>
                        <span class="terms-text">
                            I agree to the <a href="#">Terms of Use</a> &amp; <a href="#">Privacy Policy</a>
                        </span>
                    </label>
                    <div class="error-message" id="termsError"></div>
                </div>

                <!-- submit -->
                <button type="submit" class="btn-primary">Create Account</button>
            </form>

            <!-- divider -->
            <div class="divider">
                <span>or continue with</span>
            </div>

            <!-- social – Google only -->
            <a href="/users/auth/google" class="btn-google" type="button">
                <svg width="20" height="20" viewBox="0 0 48 48"><path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/><path fill="#FF3D00" d="m6.306 14.691 6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/><path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238A11.91 11.91 0 0 1 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/><path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303a12.04 12.04 0 0 1-4.087 5.571l.003-.002 6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/></svg>
                <span>Log in with Google</span>
            </a>

            <!-- footer -->
            <div class="card-footer">
                Already have an account? <a href="/users/login">Log in</a>
            </div>
        </div>
    </div>

    <script src="/js/register.js"></script>

    <style>
        /* ============================================================
        DESIGN SYSTEM (your existing tokens, extended)
        ============================================================ */
        :root {
            /* ---- primary brand ---- */
            --primary: #88c8bc;
            --primary-dark: #66a59b;
            --primary-light: #f0f9f7;

            /* ---- secondary ---- */
            --secondary: #46698f;
            --secondary-dark: #395884;

            /* ---- accent ---- */
            --success: #28a745;

            /* ---- neutrals ---- */
            --white: #ffffff;
            --off-white: #f8fafc;
            --gray-50: #f9fafb;
            --gray-100: #f1f3f5;
            --gray-200: #e9ecef;
            --gray-300: #dee2e6;
            --gray-400: #ced4da;
            --gray-500: #adb5bd;
            --gray-600: #6c757d;
            --gray-700: #495057;
            --gray-800: #343a40;
            --gray-900: #1a1a2e;
            --black: #000000;

            /* ---- shadows ---- */
            --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.04);
            --shadow-md: 0 8px 40px rgba(0, 0, 0, 0.07);
            --shadow-lg: 0 16px 60px rgba(0, 0, 0, 0.10);
            --shadow-hover: 0 12px 48px rgba(0, 0, 0, 0.12);

            /* ---- radii ---- */
            --radius-sm: 8px;
            --radius: 14px;
            --radius-lg: 24px;

            /* ---- spacing ---- */
            --space-1: 4px;
            --space-2: 8px;
            --space-3: 12px;
            --space-4: 16px;
            --space-5: 20px;
            --space-6: 24px;
            --space-8: 32px;
            --space-10: 40px;
            --space-12: 48px;

            /* ---- fonts ---- */
            --font: 'Poppins', system-ui, -apple-system, sans-serif;
            --font-weight-normal: 400;
            --font-weight-medium: 500;
            --font-weight-semibold: 600;
            --font-weight-bold: 700;

            /* ---- transitions ---- */
            --ease: cubic-bezier(0.25, 0.46, 0.45, 0.94);
            --duration: 0.30s;
        }

        /* ============================================================
        RESET & BASE
        ============================================================ */
        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            font-size: 62.5%;
            /* 10px base */
        }

        body {
            font-family: var(--font);
            font-size: 1.6rem;
            font-weight: var(--font-weight-normal);
            line-height: 1.6;
            color: var(--gray-800);
            background: var(--off-white);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            -webkit-font-smoothing: antialiased;
        }

        a {
            color: var(--primary-dark);
            text-decoration: none;
            font-weight: var(--font-weight-medium);
            transition: color var(--duration) ease;
        }
        a:hover {
            color: var(--primary);
            text-decoration: underline;
        }

        .logo-md {
          width: 165px;
        }

        /* ============================================================
        PAGE – subtle background with soft circles
        ============================================================ */
        .page {
            position: relative;
            width: 100%;
            max-width: 440px;
            margin: 0 auto;
        }

        .bg-circle {
            position: fixed;
            border-radius: 50%;
            pointer-events: none;
            z-index: 0;
            opacity: 0.30;
        }
        .bg-circle-1 {
            width: 380px;
            height: 380px;
            top: -120px;
            right: -120px;
            background: radial-gradient(circle, var(--primary-light) 0%, transparent 70%);
        }
        .bg-circle-2 {
            width: 300px;
            height: 300px;
            bottom: -100px;
            left: -100px;
            background: radial-gradient(circle, rgba(136, 200, 188, 0.15) 0%, transparent 70%);
        }

        /* ============================================================
        CARD
        ============================================================ */
        .card {
            position: relative;
            z-index: 1;
            background: var(--white);
            padding: 4rem 3.2rem 3.6rem;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            transition: box-shadow var(--duration) ease;
            backdrop-filter: blur(2px);
        }
        .card:hover {
            box-shadow: var(--shadow-lg);
        }

        /* ---- brand ---- */
        .card-brand {
          display: flex;
          align-items: center;
          justify-content: center;
          font-family: 'Rokkitt', Georgia, serif;
          font-size: 34px;
          font-weight: 700;
          color: var(--primary);
          text-transform: uppercase;
          letter-spacing: 1px;
          margin: 0;
        }
        .brand-icon {
            font-size: 2.2rem;
            color: var(--primary);
        }
        .brand-name {
            font-weight: var(--font-weight-medium);
        }
        .brand-accent a {
            font-weight: var(--font-weight-bold) !important;
            color: var(--primary);
            text-decoration: none;
        }

        /* ---- header ---- */
        .card-header {
            text-align: center;
            margin-bottom: 3.2rem;
        }
        .card-header h1 {
            font-size: 2.8rem;
            font-weight: var(--font-weight-semibold);
            letter-spacing: -0.5px;
            color: var(--gray-900);
            line-height: 1.2;
        }
        .card-header p {
            margin-top: 0.4rem;
            font-size: 1.5rem;
            color: var(--gray-600);
            font-weight: var(--font-weight-normal);
        }

        /* ============================================================
        FORM
        ============================================================ */
        .form {
            display: flex;
            flex-direction: column;
            gap: 1.8rem;
        }

        /* ---- Floating label fields ---- */
        .field {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-wrapper input {
            width: 100%;
            height: 52px;
            padding: 0 1.6rem;
            font-size: 1.5rem;
            font-family: var(--font);
            color: var(--gray-900);
            background: var(--white);
            border: 1.5px solid var(--gray-300);
            border-radius: var(--radius-sm);
            outline: none;
            transition: border-color var(--duration) ease, box-shadow var(--duration) ease;
            -webkit-appearance: none;
        }

        .input-wrapper input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(136, 200, 188, 0.18);
        }
        .input-wrapper input:not(:placeholder-shown) {
            border-color: var(--gray-400);
        }

        .input-wrapper label {
            position: absolute;
            top: 50%;
            left: 1.6rem;
            transform: translateY(-50%);
            font-size: 1.4rem;
            font-weight: var(--font-weight-normal);
            color: var(--gray-500);
            pointer-events: none;
            transition: all var(--duration) ease;
            background: var(--white);
            padding: 0 4px;
            line-height: 1;
        }

        .input-wrapper input:focus + label,
        .input-wrapper input:not(:placeholder-shown) + label {
            top: 0;
            left: 1.2rem;
            transform: translateY(-50%);
            font-size: 1.1rem;
            font-weight: var(--font-weight-medium);
            color: var(--primary-dark);
            background: var(--white);
        }

        .input-wrapper input:not(:focus):not(:placeholder-shown) + label {
            color: var(--gray-600);
        }

        /* ---- Toggle password button (moved inside .input-wrapper) ---- */
        .input-wrapper .toggle-password {
            position: absolute;
            right: 1.2rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--gray-500);
            cursor: pointer;
            padding: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: color var(--duration) ease, background var(--duration) ease;
        }

        .input-wrapper .toggle-password:hover {
            color: var(--gray-700);
            background: var(--gray-100);
        }

        .input-wrapper .toggle-password svg {
            display: block;
        }

        /* ---- Error message ---- */
        .error-message {
            font-size: 1.2rem;
            color: #dc3545;
            min-height: 1.8rem;
            transition: all 0.2s ease;
        }

        /* ---- Field error state ---- */
        .field.error .input-wrapper input {
            border-color: #dc3545;
            box-shadow: 0 0 0 4px rgba(220,53,69,0.15);
        }
        .field.error .input-wrapper label {
            color: #dc3545;
        }

        /* ---- password toggle ---- */
        .toggle-password {
            position: absolute;
            right: 1.2rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--gray-500);
            cursor: pointer;
            padding: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: color var(--duration) ease, background var(--duration) ease;
        }
        .toggle-password:hover {
            color: var(--gray-700);
            background: var(--gray-100);
        }
        .toggle-password svg {
            display: block;
        }

        /* ---- terms checkbox ---- */
        .terms {
            margin: 0.4rem 0 0.2rem;
        }
        .checkbox {
            display: inline-flex;
            align-items: flex-start;
            gap: 1rem;
            cursor: pointer;
            font-size: 1.3rem;
            font-weight: var(--font-weight-normal);
            color: var(--gray-700);
            line-height: 1.5;
        }
        .checkbox input {
            position: absolute;
            opacity: 0;
            width: 0;
            height: 0;
            pointer-events: none;
        }
        .checkmark {
            flex-shrink: 0;
            width: 20px;
            height: 20px;
            margin-top: 1px;
            border: 2px solid var(--gray-400);
            border-radius: 5px;
            background: var(--white);
            transition: all var(--duration) ease;
            position: relative;
        }
        .checkbox input:checked+.checkmark {
            background: var(--primary);
            border-color: var(--primary);
        }
        .checkbox input:checked+.checkmark::after {
            content: "";
            position: absolute;
            top: 3px;
            left: 6px;
            width: 5px;
            height: 10px;
            border: solid white;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg);
        }
        .checkbox input:focus-visible+.checkmark {
            box-shadow: 0 0 0 4px rgba(136, 200, 188, 0.25);
        }
        .terms-text a {
            font-weight: var(--font-weight-medium);
        }

        /* ---- primary button ---- */
        .btn-primary {
            width: 100%;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            font-weight: var(--font-weight-semibold);
            font-family: var(--font);
            color: var(--white);
            background: var(--primary);
            border: none;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all var(--duration) ease;
            margin-top: 0.4rem;
            letter-spacing: 0.2px;
        }
        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(136, 200, 188, 0.30);
        }
        .btn-primary:active {
            transform: translateY(0);
            box-shadow: none;
        }
        .btn-primary:focus-visible {
            outline: 2px solid var(--primary-dark);
            outline-offset: 3px;
        }
        .btn-primary:disabled {
            opacity: 0.7;
            cursor: default;
            transform: none;
            box-shadow: none;
        }

        /* ============================================================
        DIVIDER
        ============================================================ */
        .divider {
            display: flex;
            align-items: center;
            gap: 1.6rem;
            margin: 2.4rem 0 1.6rem;
        }
        .divider::before,
        .divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: var(--gray-200);
        }
        .divider span {
            font-size: 1.2rem;
            font-weight: var(--font-weight-medium);
            color: var(--gray-500);
            text-transform: uppercase;
            letter-spacing: 0.6px;
            white-space: nowrap;
        }

        /* ============================================================
        GOOGLE BUTTON
        ============================================================ */
        .btn-google {
            width: 100%;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1.2rem;
            font-size: 1.5rem;
            font-weight: var(--font-weight-medium);
            font-family: var(--font);
            color: var(--gray-700);
            background: var(--white);
            border: 1.5px solid var(--gray-300);
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all var(--duration) ease;
            margin-top: 0.2rem;
            text-decoration: none !important;
        }
        .btn-google:hover {
            background: var(--gray-50);
            border-color: var(--gray-400);
            box-shadow: var(--shadow-sm);
            transform: translateY(-1px);
        }
        .btn-google:active {
            transform: translateY(0);
        }
        .btn-google:focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
        }
        .btn-google svg {
            flex-shrink: 0;
        }

        /* ---- Error messages ---- */
        .error-message {
            font-size: 1.2rem;
            color: #dc3545;
            margin-top: 4px;
            min-height: 1.8rem;
            transition: all 0.2s ease;
        }
        .field.error input {
            border-color: #dc3545;
            box-shadow: 0 0 0 4px rgba(220,53,69,0.15);
        }
        .field.error label {
            color: #dc3545;
        }
        .error-alert {
            background: #f8d7da;
            border: 1px solid #f5c6cb;
            color: #721c24;
            padding: 10px 14px;
            border-radius: 6px;
            font-size: 1.4rem;
            margin-bottom: 1.6rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .error-alert i {
            font-size: 1.8rem;
        }

        .success-alert {
            background: #d1e7dd;
            border: 1px solid #badbcc;
            color: #0f5132 !important;
            padding: 14px 16px;
            border-radius: 8px;
            font-size: 1.4rem;
            line-height: 1.7;
            margin-bottom: 1.6rem;
        }

        /* ============================================================
        FOOTER
        ============================================================ */
        .card-footer {
            margin-top: 2.8rem;
            text-align: center;
            font-size: 1.4rem;
            color: var(--gray-600);
        }
        .card-footer a {
            font-weight: var(--font-weight-medium);
        }

        /* ============================================================
        RESPONSIVE
        ============================================================ */
        @media (max-width: 500px) {
            .card {
                padding: 3.2rem 2rem 2.8rem;
            }
            .card-header h1 {
                font-size: 2.4rem;
            }
            .field input {
                height: 46px;
                font-size: 1.4rem;
            }
            .btn-primary,
            .btn-google {
                height: 44px;
                font-size: 1.4rem;
            }
            .bg-circle-1 {
                width: 240px;
                height: 240px;
                top: -80px;
                right: -80px;
            }
            .bg-circle-2 {
                width: 200px;
                height: 200px;
                bottom: -60px;
                left: -60px;
            }
        }

        @media (max-width: 380px) {
            .card {
                padding: 2.4rem 1.6rem 2.4rem;
            }
            .card-brand {
                font-size: 1.6rem;
            }
            .btn-google span {
                font-size: 1.3rem;
            }
        }

        /* ============================================================
        ACCESSIBILITY – reduced motion
        ============================================================ */
        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>

</body>

</html>